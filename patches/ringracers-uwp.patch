diff --git a/src/rhi/gl2/gl2_rhi.cpp b/src/rhi/gl2/gl2_rhi.cpp
index cf35eebb5..b6de6e4c5 100644
--- a/src/rhi/gl2/gl2_rhi.cpp
+++ b/src/rhi/gl2/gl2_rhi.cpp
@@ -10,6 +10,7 @@
 
 #include "gl2_rhi.hpp"
 
