+/// \file r_d3d11.h
+/// \brief [UWP]: Legacy GL's driver for Direct3D 11, presented through ANGLE
+
+#ifndef __R_D3D11_H__
+#define __R_D3D11_H__
+
+#include "../../doomtype.h"
+
+#ifdef __cplusplus
+extern "C" {
