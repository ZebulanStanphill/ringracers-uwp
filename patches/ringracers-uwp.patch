+	D3D11_FinishUpdate(waitvbl);
+}
+
+void D3D_Draw2DLine(F2DCoord *v1, F2DCoord *v2, RGBA_t Color)
+{
+	CpuTimer timer(g_stats.drawTime);
+	FOutVector p[4];
+	float angle;
+
+	g_gl.texture2D = false;
+
+	// This is the preferred, 'modern' way of rendering lines -- creating a polygon.
+	if (fabsf(v2->x - v1->x) > FLT_EPSILON)
+		angle = (float)atan((v2->y-v1->y)/(v2->x-v1->x));
+	else
+		angle = (float)(M_PI / 2.0);
+	const float dx = (float)sin(angle) / (float)g_screenWidth;
+	const float dy = (float)cos(angle) / (float)g_screenHeight;
+
+	memset(p, 0, sizeof p);
+	p[0].x = v1->x - dx;  p[0].y = -(v1->y + dy); p[0].z = 1;
+	p[1].x = v2->x - dx;  p[1].y = -(v2->y + dy); p[1].z = 1;
+	p[2].x = v2->x + dx;  p[2].y = -(v2->y - dy); p[2].z = 1;
+	p[3].x = v1->x + dx;  p[3].y = -(v1->y - dy); p[3].z = 1;
+
+	SetColor(&Color.s.red);
+	DrawArrays(LAYOUT_POLY, PRIM_FAN, p, 4);
+	g_stats.lines++;
+
+	g_gl.texture2D = true;
+}
+
+// r_opengl.c's PreparePolygon
+void PreparePolygon(FSurfaceInfo *pSurf, FBITFIELD PolyFlags)
+{
+	static float poly[4] = {0, 0, 0, 0};
+	static float tint[4] = {0, 0, 0, 0};
+	static float fade[4] = {0, 0, 0, 0};
+
+	// Coronas read back the depth buffer in r_opengl.c, unless it can't (GLF_NOZBUFREAD), which is what this does
+	if (PolyFlags & PF_Corona)
+	{
+		LOG_ONCE("drawing coronas as if the depth buffer can't be read (logged once)");
+		PolyFlags &= ~(PF_NoDepthTest|PF_Corona);
+	}
+
+	D3D_SetBlend(PolyFlags);
+
+	if (pSurf)
+	{
+		// If modulated, mix the surface colour to the texture
+		if (g_currentPolyFlags & PF_Modulated)
+			SetColor(&pSurf->PolyColor.s.red);
+
+		// If the surface is either modulated or colormapped, or both
+		if (g_currentPolyFlags & (PF_Modulated | PF_ColorMapped))
+		{
+			poly[0] = pSurf->PolyColor.s.red / 255.0f;
+			poly[1] = pSurf->PolyColor.s.green / 255.0f;
+			poly[2] = pSurf->PolyColor.s.blue / 255.0f;
+			poly[3] = pSurf->PolyColor.s.alpha / 255.0f;
+		}
+
+		// Only if the surface is colormapped
+		if (g_currentPolyFlags & PF_ColorMapped)
+		{
+			SetLightTable(pSurf->LightTableId);
+
+			tint[0] = pSurf->TintColor.s.red / 255.0f;
+			tint[1] = pSurf->TintColor.s.green / 255.0f;
+			tint[2] = pSurf->TintColor.s.blue / 255.0f;
+			tint[3] = pSurf->TintColor.s.alpha / 255.0f;
+
+			fade[0] = pSurf->FadeColor.s.red / 255.0f;
+			fade[1] = pSurf->FadeColor.s.green / 255.0f;
+			fade[2] = pSurf->FadeColor.s.blue / 255.0f;
+			fade[3] = pSurf->FadeColor.s.alpha / 255.0f;
+		}
+	}
+
+	SetUniforms(pSurf, poly, tint, fade);
+}
+
+void D3D_DrawPolygon(FSurfaceInfo *pSurf, FOutVector *pOutVerts, FUINT iNumPts, FBITFIELD PolyFlags)
+{
+	CpuTimer timer(g_stats.drawTime);
+
+	PreparePolygon(pSurf, PolyFlags);
+
+	if (PolyFlags & PF_WireFrame)
+		DrawArrays(LAYOUT_POLY, PRIM_LINES, pOutVerts, (UINT)iNumPts);
+	else
+		DrawArrays(LAYOUT_POLY, PRIM_FAN, pOutVerts, (UINT)iNumPts);
+	g_stats.polygons++;
+
+	if (PolyFlags & PF_RemoveYWrap)
+		SetRepeatT(true);
+
+	if (PolyFlags & PF_ForceWrapX)
+		SetRepeatS(false);
+
+	if (PolyFlags & PF_ForceWrapY)
+		SetRepeatT(false);
+}
+
+void D3D_DrawIndexedTriangles(FSurfaceInfo *pSurf, FOutVector *pOutVerts, FUINT iNumPts, FBITFIELD PolyFlags, UINT32 *IndexArray)
+{
+	CpuTimer timer(g_stats.drawTime);
+
+	PreparePolygon(pSurf, PolyFlags);
+	g_stats.batches++;
+
+	if (!CanDraw() || iNumPts == 0)
+		return;
+
+	// Only the indices' count is given
+	UINT32 vertexCount = 0;
+	for (FUINT i = 0; i < iNumPts; i++)
+	{
+		if (IndexArray[i] >= vertexCount)
+			vertexCount = IndexArray[i] + 1;
+	}
+
+	const UINT stride = sizeof(FOutVector);
+	const UINT vertexOffset = RingWrite(g_vertexRing, pOutVerts, vertexCount * stride, stride);
+	const UINT indexOffset = RingWrite(g_indexRing, IndexArray, (UINT)(iNumPts * sizeof(UINT32)), sizeof(UINT32));
+	if (vertexOffset == UINT_MAX || indexOffset == UINT_MAX)
+		return;
+
+	BindVertexBuffer(g_vertexRing.buffer.Get(), stride);
+	BindIndexBuffer(g_indexRing.buffer.Get(), DXGI_FORMAT_R32_UINT);
+	ApplyState(LAYOUT_POLY, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+	g_context->DrawIndexed((UINT)iNumPts, indexOffset / sizeof(UINT32), vertexOffset / stride);
+	g_stats.vertices += vertexCount;
+	g_stats.indices += iNumPts;
+}
+
+StaticBuffer g_skyBuffer;
+
+void D3D_RenderSkyDome(gl_sky_t *sky)
+{
+	CpuTimer timer(g_stats.drawTime);
+
+	SetUniforms(NULL, NULL, NULL, NULL);
+
+	if (!CanDraw())
+		return;
+
+	// Build the sky dome! Yes!
+	if (sky->rebuild || !g_skyBuffer)
+	{
+		CreateStaticBuffer(sky->data, (UINT)(sky->vertex_count * sizeof(sky->data[0])), D3D11_BIND_VERTEX_BUFFER, g_skyBuffer);
+		sky->vbo = 1;
+		sky->rebuild = false;
+		g_stats.skyBuilds++;
+		LOG_ONCE("built a sky dome of %d vertices in %d loops (counted in the perf summary after this)", sky->vertex_count,
+			sky->loopcount);
+	}
+
+	if (!g_skyBuffer)
+		return;
+
+	// set transforms
+	MatScale(1.0f, (float)sky->height / 200.0f, 1.0f);
+	MatRotate(270.0f, 0.0f, 1.0f, 0.0f);
+
+	BindVertexBuffer(g_skyBuffer.Get(), sizeof(gl_skyvertex_t));
+
+	for (int j = 0; j < 2; j++)
+	{
+		for (int i = 0; i < sky->loopcount; i++)
+		{
+			gl_skyloopdef_t *loop = &sky->loops[i];
+
+			if (j == 0 ? loop->use_texture : !loop->use_texture)
+				continue;
+
+			if (loop->mode == HWD_SKYLOOP_FAN)
+			{
+				if (loop->vertexcount < 3 || (UINT)loop->vertexcount > kMaxFanVertices)
+					continue;
+				ApplyState(LAYOUT_SKY, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+				BindIndexBuffer(g_fanIndices.Get(), DXGI_FORMAT_R16_UINT);
+				g_context->DrawIndexed((loop->vertexcount - 2) * 3, 0, loop->vertexindex);
+			}
+			else if (loop->mode == HWD_SKYLOOP_STRIP)
+			{
+				ApplyState(LAYOUT_SKY, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP);
+				g_context->Draw(loop->vertexcount, loop->vertexindex);
+			}
+			else
+				continue;
+
+			g_stats.vertices += loop->vertexcount;
+		}
+	}
+
+	SetColor(kWhite);
+	g_stats.skies++;
+}
