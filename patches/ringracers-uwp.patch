+// r_opengl.c's Shader_SetUniforms
+void SetUniforms(const FSurfaceInfo *surface, const float *poly, const float *tint, const float *fade)
+{
+	static const float white[4] = {1.0f, 1.0f, 1.0f, 1.0f};
+
+	if (!g_shadersEnabled || g_shaderCurrent < 0)
+		return;
+
+	if (!ProgramExists(g_shaderCurrent))
+	{
+		g_program = -1;
+		return;
+	}
+
+	if (g_shaderChanged)
+	{
+		g_program = g_shaderCurrent;
+		g_shaderChanged = false;
+	}
+
+	if (g_program < 0)
+		return;
+
+	ProgramUniforms &u = g_uniforms[g_program];
+	boolean directional = false;
+
+	memcpy(u.poly, poly ? poly : white, sizeof u.poly);
+	memcpy(u.tint, tint ? tint : white, sizeof u.tint);
+	memcpy(u.fade, fade ? fade : white, sizeof u.fade);
+
+	if (surface != NULL)
+	{
+		u.lighting = (float)surface->LightInfo.light_level;
+		u.fadeStart = (float)surface->LightInfo.fade_start;
+		u.fadeEnd = (float)surface->LightInfo.fade_end;
+		directional = surface->LightInfo.directional;
+	}
+	else
+	{
+		u.lighting = 255.0f;
+		u.fadeStart = 0.0f;
+		u.fadeEnd = 31.0f;
+	}
+
+	if (directional)
+	{
+		u.lightDir[0] = g_shaderLightX;
+		u.lightDir[1] = g_shaderLightY;
+		u.lightDir[2] = g_shaderLightZ;
+		u.lightContrast = (float)g_shaderLightContrast;
+		u.lightBacklight = (float)g_shaderLightBacklight;
+	}
+	else
+	{
+		u.lightDir[0] = u.lightDir[1] = u.lightDir[2] = 0.0f;
+		u.lightContrast = u.lightBacklight = 0.0f;
+	}
+
+	u.leveltime = ((float)g_shaderLeveltime) / TICRATE;
+}
+
+// ==========================================================================
+//                                                              STATE OBJECTS
+// ==========================================================================
+
+D3D11_BLEND ToD3DBlend(UINT8 factor)
+{
+	switch (factor)
+	{
+		case BF_ZERO: return D3D11_BLEND_ZERO;
+		case BF_ONE: return D3D11_BLEND_ONE;
+		case BF_SRC_ALPHA: return D3D11_BLEND_SRC_ALPHA;
+		case BF_ONE_MINUS_SRC_ALPHA: return D3D11_BLEND_INV_SRC_ALPHA;
+		case BF_SRC_COLOR: return D3D11_BLEND_SRC_COLOR;
+		case BF_DST_COLOR: return D3D11_BLEND_DEST_COLOR;
+		case BF_ONE_MINUS_DST_COLOR: return D3D11_BLEND_INV_DEST_COLOR;
+		default: return D3D11_BLEND_ONE;
+	}
+}
+
+ID3D11BlendState *GetBlendState()
+{
+	UINT32 key = 0;
+
+	// GL_ONE, GL_ZERO, GL_FUNC_ADD is the same as not blending
+	if (g_gl.blend && !(g_gl.blendSrc == BF_ONE && g_gl.blendDst == BF_ZERO && g_gl.blendEquation == BE_ADD))
+		key = 1 | (g_gl.blendSrc << 1) | (g_gl.blendDst << 4) | (g_gl.blendEquation << 7);
+
+	static UINT32 lastKey = UINT32_MAX;
+	static ID3D11BlendState *last = nullptr;
+	if (key == lastKey)
+		return last;
+
+	auto it = g_blendStates.find(key);
+	if (it != g_blendStates.end())
+	{
+		lastKey = key;
+		return last = it->second.Get();
+	}
+
+	D3D11_BLEND_DESC desc = {};
+	D3D11_RENDER_TARGET_BLEND_DESC &target = desc.RenderTarget[0];
+
+	target.BlendEnable = key != 0;
+	target.SrcBlend = ToD3DBlend(g_gl.blendSrc);
+	target.DestBlend = ToD3DBlend(g_gl.blendDst);
+	target.BlendOp = g_gl.blendEquation == BE_SUBTRACT ? D3D11_BLEND_OP_SUBTRACT
+		: g_gl.blendEquation == BE_REVERSE_SUBTRACT ? D3D11_BLEND_OP_REV_SUBTRACT : D3D11_BLEND_OP_ADD;
+	target.SrcBlendAlpha = D3D11_BLEND_ONE;
+	target.DestBlendAlpha = D3D11_BLEND_ZERO;
+	target.BlendOpAlpha = D3D11_BLEND_OP_ADD;
+	// The screen's alpha stays 1, like the GL_RGB textures r_opengl.c copies the screen to
+	target.RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_RED | D3D11_COLOR_WRITE_ENABLE_GREEN | D3D11_COLOR_WRITE_ENABLE_BLUE;
+
+	ComPtr<ID3D11BlendState> state;
+	if (Failed(g_device->CreateBlendState(&desc, &state), "CreateBlendState"))
+		return nullptr;
+	g_blendStates[key] = state;
+	return state.Get();
+}
+
+ID3D11DepthStencilState *GetDepthState()
+{
+	const UINT32 key = (g_gl.depthTest ? 1 : 0) | (g_gl.depthAlways ? 2 : 0) | (g_gl.depthMask ? 4 : 0);
+
+	static UINT32 lastKey = UINT32_MAX;
+	static ID3D11DepthStencilState *last = nullptr;
+	if (key == lastKey)
+		return last;
+
+	auto it = g_depthStates.find(key);
+	if (it != g_depthStates.end())
+	{
+		lastKey = key;
+		return last = it->second.Get();
+	}
+
+	D3D11_DEPTH_STENCIL_DESC desc = {};
+	desc.DepthEnable = g_gl.depthTest; // which, like OpenGL, also stops depth writes
+	desc.DepthWriteMask = g_gl.depthMask ? D3D11_DEPTH_WRITE_MASK_ALL : D3D11_DEPTH_WRITE_MASK_ZERO;
+	desc.DepthFunc = g_gl.depthAlways ? D3D11_COMPARISON_ALWAYS : D3D11_COMPARISON_LESS_EQUAL;
+	desc.StencilEnable = FALSE;
+
+	ComPtr<ID3D11DepthStencilState> state;
+	if (Failed(g_device->CreateDepthStencilState(&desc, &state), "CreateDepthStencilState"))
+		return nullptr;
+	g_depthStates[key] = state;
+	return state.Get();
+}
+
+ID3D11RasterizerState *GetRasterState()
+{
+	const UINT32 cull = g_gl.cullFace ? (g_gl.cullFront ? 2 : 1) : 0;
+	const UINT32 key = cull | (g_gl.polygonOffset ? 4 : 0);
+
+	static UINT32 lastKey = UINT32_MAX;
+	static ID3D11RasterizerState *last = nullptr;
+	if (key == lastKey)
+		return last;
+
+	auto it = g_rasterStates.find(key);
+	if (it != g_rasterStates.end())
+	{
+		lastKey = key;
+		return last = it->second.Get();
+	}
+
+	D3D11_RASTERIZER_DESC desc = {};
+	desc.FillMode = D3D11_FILL_SOLID;
+	desc.CullMode = cull == 2 ? D3D11_CULL_FRONT : cull == 1 ? D3D11_CULL_BACK : D3D11_CULL_NONE;
+	desc.FrontCounterClockwise = TRUE; // like OpenGL
+	// glPolygonOffset(-1.0f, -1.0f)
+	desc.DepthBias = g_gl.polygonOffset ? -1 : 0;
+	desc.SlopeScaledDepthBias = g_gl.polygonOffset ? -1.0f : 0.0f;
+	desc.DepthBiasClamp = 0.0f;
+	desc.DepthClipEnable = TRUE;
+
+	ComPtr<ID3D11RasterizerState> state;
+	if (Failed(g_device->CreateRasterizerState(&desc, &state), "CreateRasterizerState"))
+		return nullptr;
+	g_rasterStates[key] = state;
+	return state.Get();
+}
+
+ID3D11SamplerState *GetSampler(Texture *texture)
+{
+	if (texture->sampler)
+		return texture->sampler;
+
+	const UINT32 lod = texture->maxLod >= 15.0f ? 15 : (UINT32)texture->maxLod;
+	const UINT32 anisotropy = (UINT32)std::min(std::max(texture->anisotropy, 1), kMaximumAnisotropy);
+	const UINT32 key = texture->minFilter | (texture->magFilter << 2) | (texture->repeatS ? 1 << 4 : 0)
+		| (texture->repeatT ? 1 << 5 : 0) | (lod << 6) | (anisotropy << 10);
+
+	auto it = g_samplers.find(key);
+	if (it != g_samplers.end())
+		return texture->sampler = it->second.Get();
+
+	const bool mipmap = texture->minFilter == FILTER_LINEAR_MIPMAP_LINEAR || texture->minFilter == FILTER_NEAREST_MIPMAP_LINEAR;
+	const bool minLinear = texture->minFilter == FILTER_LINEAR || texture->minFilter == FILTER_LINEAR_MIPMAP_LINEAR;
+	const bool magLinear = texture->magFilter == FILTER_LINEAR;
+	D3D11_SAMPLER_DESC desc = {};
+
+	if (anisotropy > 1 && texture->minFilter != FILTER_NEAREST)
+	{
+		desc.Filter = D3D11_FILTER_ANISOTROPIC;
+		desc.MaxAnisotropy = anisotropy;
+	}
+	else
+	{
+		static const D3D11_FILTER filters[2][2][2] = // [minLinear][magLinear][mipmap]
+		{
+			{
+				{D3D11_FILTER_MIN_MAG_MIP_POINT, D3D11_FILTER_MIN_MAG_POINT_MIP_LINEAR},
+				{D3D11_FILTER_MIN_POINT_MAG_LINEAR_MIP_POINT, D3D11_FILTER_MIN_POINT_MAG_MIP_LINEAR},
+			},
+			{
+				{D3D11_FILTER_MIN_LINEAR_MAG_MIP_POINT, D3D11_FILTER_MIN_LINEAR_MAG_POINT_MIP_LINEAR},
+				{D3D11_FILTER_MIN_MAG_LINEAR_MIP_POINT, D3D11_FILTER_MIN_MAG_MIP_LINEAR},
+			},
+		};
+		desc.Filter = filters[minLinear][magLinear][mipmap];
+		desc.MaxAnisotropy = 1;
+	}
+
+	desc.AddressU = texture->repeatS ? D3D11_TEXTURE_ADDRESS_WRAP : D3D11_TEXTURE_ADDRESS_CLAMP;
+	desc.AddressV = texture->repeatT ? D3D11_TEXTURE_ADDRESS_WRAP : D3D11_TEXTURE_ADDRESS_CLAMP;
+	desc.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+	desc.ComparisonFunc = D3D11_COMPARISON_NEVER;
+	desc.MinLOD = 0.0f;
+	// Without a mipmap filter, OpenGL samples only the base level
+	desc.MaxLOD = mipmap ? (float)lod : 0.0f;
+	if (mipmap && lod == 15)
+		desc.MaxLOD = D3D11_FLOAT32_MAX;
+
+	ComPtr<ID3D11SamplerState> state;
+	if (Failed(g_device->CreateSamplerState(&desc, &state), "CreateSamplerState"))
+		return g_defaultSampler.Get();
+	g_samplers[key] = state;
+	return texture->sampler = state.Get();
+}
+
+// ==========================================================================
+//                                                                    DRAWING
+// ==========================================================================
+
+bool CreateRing(Ring &ring, UINT size, UINT bind, const char *name)
+{
+	D3D11_BUFFER_DESC desc = {};
+	desc.ByteWidth = size;
+	desc.Usage = D3D11_USAGE_DYNAMIC;
+	desc.BindFlags = bind;
+	desc.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+
+	ring.buffer.Reset();
+	if (Failed(g_device->CreateBuffer(&desc, nullptr, &ring.buffer), name))
+	{
+		ring.size = 0;
+		return false;
+	}
+
+	ring.size = size;
+	ring.position = 0;
+	ring.bind = bind;
+	ring.fresh = true;
+	ring.name = name;
+	return true;
+}
+
+// Appends data to a ring, returning its offset, or UINT_MAX if it couldn't
+UINT RingWrite(Ring &ring, const void *data, UINT bytes, UINT align)
+{
+	if (bytes > ring.size)
+	{
+		const UINT size = std::max(bytes * 2, ring.size * 2);
+		Log("growing the %s buffer from %u to %u bytes for a draw of %u bytes", ring.name, ring.size, size, bytes);
+		if (!CreateRing(ring, size, ring.bind, ring.name))
+			return UINT_MAX;
+		// It might be bound
+		if (ring.bind == D3D11_BIND_VERTEX_BUFFER)
+			g_bound.vertexBuffer = nullptr;
+		else
+			g_bound.indexBuffer = nullptr;
+	}
+
+	UINT start = (ring.position + align - 1) / align * align;
+	D3D11_MAP map = ring.fresh ? D3D11_MAP_WRITE_DISCARD : D3D11_MAP_WRITE_NO_OVERWRITE;
+
+	if (start + bytes > ring.size)
+	{
+		start = 0;
+		map = D3D11_MAP_WRITE_DISCARD;
+		g_stats.ringWraps++;
+	}
+
+	D3D11_MAPPED_SUBRESOURCE mapped;
+	if (Failed(g_context->Map(ring.buffer.Get(), 0, map, 0, &mapped), "Map"))
+		return UINT_MAX;
+	memcpy(static_cast<BYTE*>(mapped.pData) + start, data, bytes);
+	g_context->Unmap(ring.buffer.Get(), 0);
+
+	ring.fresh = false;
+	ring.position = start + bytes;
+	g_stats.uploadBytes += bytes;
+	return start;
+}
+
+void BindVertexBuffer(ID3D11Buffer *buffer, UINT stride)
+{
+	if (g_bound.vertexBuffer != buffer || g_bound.stride != stride)
+	{
+		const UINT offset = 0;
+		g_context->IASetVertexBuffers(0, 1, &buffer, &stride, &offset);
+		g_bound.vertexBuffer = buffer;
+		g_bound.stride = stride;
+	}
+}
+
+void BindIndexBuffer(ID3D11Buffer *buffer, DXGI_FORMAT format)
+{
+	if (g_bound.indexBuffer != buffer || g_bound.indexFormat != format)
+	{
+		g_context->IASetIndexBuffer(buffer, format, 0);
+		g_bound.indexBuffer = buffer;
+		g_bound.indexFormat = format;
+	}
+}
+
+void ApplyConstants()
+{
+	Constants c;
+	const bool lit = g_gl.lighting;
+
+	memset(&c, 0, sizeof c);
+	memcpy(c.projection, g_projection.m, sizeof c.projection);
+	memcpy(c.modelview, g_modelview.back().m, sizeof c.modelview);
+
+	if (g_program >= 0)
+	{
+		const ProgramUniforms &u = g_uniforms[g_program];
+
+		memcpy(c.poly, u.poly, sizeof c.poly);
+		memcpy(c.tint, u.tint, sizeof c.tint);
+		memcpy(c.fade, u.fade, sizeof c.fade);
+		memcpy(c.lightDir, u.lightDir, sizeof u.lightDir);
+		c.lighting = u.lighting;
+		c.fadeStart = u.fadeStart;
+		c.fadeEnd = u.fadeEnd;
+		c.lightContrast = u.lightContrast;
+		c.lightBacklight = u.lightBacklight;
+		c.leveltime = u.leveltime;
+	}
+
+	if (lit)
+	{
+		memcpy(c.color, g_gl.material, sizeof c.color);
+		memcpy(c.ffLight, g_gl.lightDir, sizeof g_gl.lightDir);
+		c.ffLight[3] = 1.0f;
+	}
+	else
+	{
+		for (int i = 0; i < 4; i++)
+			c.color[i] = g_gl.color[i] / 255.0f;
+	}
+
+	c.alphaFunc = g_gl.alphaTest ? g_gl.alphaFunc : AF_ALWAYS;
+	c.alphaRef = g_gl.alphaRef;
+
+	// Without a texture with data, or with texturing off, OpenGL's fixed function uses just the vertex color
+	if (g_gl.texture2D && g_units[0] && g_units[0]->srv)
+		c.texMode = g_gl.texEnv == TE_MODULATE ? 1 : 2;
+	else
+		c.texMode = 0;
+
+	c.palette = (g_paletteRendering && g_paletteLookupSrv && g_currentLightTable) ? 1 : 0;
+
+	if (g_constantsValid && memcmp(&c, &g_lastConstants, sizeof c) == 0)
+		return;
+
+	D3D11_MAPPED_SUBRESOURCE mapped;
+	if (Failed(g_context->Map(g_constantBuffer.Get(), 0, D3D11_MAP_WRITE_DISCARD, 0, &mapped), "Map constants"))
+		return;
+	memcpy(mapped.pData, &c, sizeof c);
+	g_context->Unmap(g_constantBuffer.Get(), 0);
+
+	g_lastConstants = c;
+	g_constantsValid = true;
+	g_stats.constantUpdates++;
+}
+
+// Sets everything a draw needs from the OpenGL state
+void ApplyState(Layout layout, D3D11_PRIMITIVE_TOPOLOGY topology, bool wipe = false)
+{
+	VSKind vs;
+	PSKind ps;
+
+	if (g_program >= 0)
+	{
+		switch (g_program)
+		{
+			case SHADER_DEFAULT: ps = PS_DEFAULT; break;
+			case SHADER_MODEL_LIGHTING: ps = PS_MODELLIGHT; break;
+			case SHADER_WATER: ps = PS_WATER; break;
+			case SHADER_FOG: ps = PS_FOG; break;
+			case SHADER_SKY: ps = PS_SKY; break;
+			default: ps = PS_SOFTWARE; break; // floors, walls, sprites, models
+		}
+
+		if (layout == LAYOUT_SKY)
+			vs = VS_SKY;
+		else if (layout == LAYOUT_MODEL)
+			vs = g_program == SHADER_MODEL_LIGHTING ? VS_MODELLIGHT : VS_MODEL;
+		else
+			vs = g_program == SHADER_SPRITECLIPHACK ? VS_POLYCLIP : VS_POLY;
+	}
+	else
+	{
+		ps = wipe ? PS_WIPE : PS_FIXED;
+		vs = layout == LAYOUT_SKY ? VS_SKY : layout == LAYOUT_MODEL ? VS_MODEL : wipe ? VS_WIPE : VS_POLY;
+	}
+
+	ID3D11InputLayout *inputLayout = g_layouts[layout].Get();
+	if (g_bound.layout != inputLayout)
+	{
+		g_context->IASetInputLayout(inputLayout);
+		g_bound.layout = inputLayout;
+	}
+
+	if (g_bound.topology != topology)
+	{
+		g_context->IASetPrimitiveTopology(topology);
+		g_bound.topology = topology;
+	}
+
+	if (g_bound.vs != g_vertexShaders[vs].Get())
+	{
+		g_context->VSSetShader(g_vertexShaders[vs].Get(), nullptr, 0);
+		g_bound.vs = g_vertexShaders[vs].Get();
+		g_stats.shaderChanges++;
+	}
+
+	if (g_bound.ps != g_pixelShaders[ps].Get())
+	{
+		g_context->PSSetShader(g_pixelShaders[ps].Get(), nullptr, 0);
+		g_bound.ps = g_pixelShaders[ps].Get();
+		g_stats.shaderChanges++;
+	}
+
+	ID3D11BlendState *blend = GetBlendState();
+	if (g_bound.blend != blend)
+	{
+		g_context->OMSetBlendState(blend, nullptr, 0xFFFFFFFF);
+		g_bound.blend = blend;
+		g_stats.blendChanges++;
+	}
+
+	ID3D11DepthStencilState *depth = GetDepthState();
+	if (g_bound.depth != depth)
+	{
+		g_context->OMSetDepthStencilState(depth, 0);
+		g_bound.depth = depth;
+		g_stats.depthChanges++;
+	}
+
+	ID3D11RasterizerState *raster = GetRasterState();
+	if (g_bound.raster != raster)
+	{
+		g_context->RSSetState(raster);
+		g_bound.raster = raster;
+		g_stats.rasterChanges++;
+	}
+
+	for (int unit = 0; unit < 2; unit++)
+	{
+		Texture *texture = g_units[unit];
+		ID3D11ShaderResourceView *srv = g_blackSrv.Get();
+		ID3D11SamplerState *sampler = g_defaultSampler.Get();
+
+		if (texture && texture->srv)
+		{
+			srv = texture->srv.Get();
+			sampler = GetSampler(texture);
+		}
+
+		if (g_bound.srvs[unit] != srv)
+		{
+			g_context->PSSetShaderResources(unit, 1, &srv);
+			g_bound.srvs[unit] = srv;
+			g_stats.textureBinds++;
+		}
+
+		if (g_bound.samplers[unit] != sampler)
+		{
+			g_context->PSSetSamplers(unit, 1, &sampler);
+			g_bound.samplers[unit] = sampler;
+		}
+	}
+
+	if (memcmp(g_bound.viewport, g_gl.viewport, sizeof g_bound.viewport) != 0)
+	{
+		D3D11_VIEWPORT viewport;
+		viewport.TopLeftX = (float)g_gl.viewport[0];
+		viewport.TopLeftY = (float)((int)g_rtHeight - (g_gl.viewport[1] + g_gl.viewport[3]));
+		viewport.Width = (float)std::max(g_gl.viewport[2], 0);
+		viewport.Height = (float)std::max(g_gl.viewport[3], 0);
+		viewport.MinDepth = 0.0f;
+		viewport.MaxDepth = 1.0f;
+		g_context->RSSetViewports(1, &viewport);
+		memcpy(g_bound.viewport, g_gl.viewport, sizeof g_bound.viewport);
+	}
+
+	if (g_paletteRendering)
+	{
+		ID3D11ShaderResourceView *srvs[2] = {g_paletteLookupSrv.Get(), g_currentLightTable};
+		if (srvs[0] != g_bound.paletteSrvs[0] || srvs[1] != g_bound.paletteSrvs[1])
+		{
+			g_context->PSSetShaderResources(2, 2, srvs);
+			g_bound.paletteSrvs[0] = srvs[0];
+			g_bound.paletteSrvs[1] = srvs[1];
+		}
+	}
+
+	ApplyConstants();
+}
+
+bool CanDraw()
+{
+	return g_context && g_rtv && !g_deviceLost;
+}
+
+enum Primitive { PRIM_FAN, PRIM_LINES, PRIM_STRIP };
+
+// Draws vertices with the current state, like glDrawArrays
+void DrawArrays(Layout layout, Primitive primitive, const void *vertices, UINT count, bool wipe = false)
+{
+	const UINT stride = kLayoutStrides[layout];
+
+	if (!CanDraw() || count == 0)
+		return;
+
+	if (primitive == PRIM_FAN && count < 3)
+		return;
+
+	const UINT offset = RingWrite(g_vertexRing, vertices, count * stride, stride);
+	if (offset == UINT_MAX)
+		return;
+	const UINT base = offset / stride;
+
+	BindVertexBuffer(g_vertexRing.buffer.Get(), stride);
+	g_stats.vertices += count;
+
+	switch (primitive)
+	{
+		case PRIM_LINES:
+			ApplyState(layout, D3D11_PRIMITIVE_TOPOLOGY_LINELIST, wipe);
+			g_context->Draw(count & ~1u, base);
+			break;
+
+		case PRIM_STRIP:
+			ApplyState(layout, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP, wipe);
+			g_context->Draw(count, base);
+			break;
+
+		case PRIM_FAN:
+			ApplyState(layout, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST, wipe);
+			if (count <= kMaxFanVertices)
+			{
+				BindIndexBuffer(g_fanIndices.Get(), DXGI_FORMAT_R16_UINT);
+				g_context->DrawIndexed((count - 2) * 3, 0, base);
+			}
+			else
+			{
+				std::vector<UINT32> indices;
+				indices.reserve((count - 2) * 3);
+				for (UINT i = 1; i + 1 < count; i++)
+				{
+					indices.push_back(0);
+					indices.push_back(i);
+					indices.push_back(i + 1);
+				}
+				const UINT indexOffset = RingWrite(g_indexRing, indices.data(), (UINT)(indices.size() * sizeof(UINT32)), sizeof(UINT32));
+				if (indexOffset == UINT_MAX)
+					return;
+				BindIndexBuffer(g_indexRing.buffer.Get(), DXGI_FORMAT_R32_UINT);
+				g_context->DrawIndexed((UINT)indices.size(), indexOffset / sizeof(UINT32), base);
+			}
+			break;
+	}
+}
+
+// ==========================================================================
+//                                                                 BLEND MODE
+// ==========================================================================
+
+// r_opengl.c's SetBlendMode
+void SetBlendMode(FBITFIELD flags)
+{
+	// Set blending function
+	if (flags & PF_Fog)
+	{
+		// Sryder: Fog
+		// multiplies input colour by input alpha, and destination colour by input colour, then adds them
+		g_gl.blendSrc = BF_SRC_ALPHA;
+		g_gl.blendDst = BF_SRC_COLOR;
+	}
+	else
+	{
+		boolean blending = true;
+		switch (flags & (PF_Blending & ~(PF_Masked | PF_Occlude)))
+		{
+			case PF_Translucent:
+				g_gl.blendSrc = BF_SRC_ALPHA; // alpha = level of transparency
+				g_gl.blendDst = BF_ONE_MINUS_SRC_ALPHA;
+				break;
+			case PF_Additive:
+			case PF_Subtractive:
+			case PF_ReverseSubtract:
+				g_gl.blendSrc = BF_SRC_ALPHA; // src * alpha + dest
+				g_gl.blendDst = BF_ONE;
+				break;
+			case PF_Environment:
+				g_gl.blendSrc = BF_ONE;
+				g_gl.blendDst = BF_ONE_MINUS_SRC_ALPHA;
+				break;
+			case PF_Multiplicative:
+				g_gl.blendSrc = BF_DST_COLOR;
+				g_gl.blendDst = BF_ZERO;
+				break;
+			case PF_Invert:
+				// [UWP]: Unlike r_opengl.c, invert the destination for Encore's white quad.
+				g_gl.blendSrc = BF_ONE_MINUS_DST_COLOR;
+				g_gl.blendDst = BF_ZERO;
+				break;
+			default:
+				blending = false;
+				break;
+		}
+
+		if (!blending)
+		{
+			if (flags & PF_Masked)
+			{
+				g_gl.blendSrc = BF_SRC_ALPHA; // 0 alpha = holes in texture
+				g_gl.blendDst = BF_ZERO;
+			}
+			else
+			{
+				g_gl.blendSrc = BF_ONE; // the same as no blending
+				g_gl.blendDst = BF_ZERO;
+			}
+		}
+	}
+
+	// Set blending equation
+	switch (flags & (PF_Blending & ~(PF_Masked | PF_Occlude)))
+	{
+		case PF_Subtractive & PF_Blending:
+			g_gl.blendEquation = BE_SUBTRACT;
+			break;
+		case PF_ReverseSubtract & PF_Blending:
+			g_gl.blendEquation = BE_REVERSE_SUBTRACT;
+			break;
+		default:
+			g_gl.blendEquation = BE_ADD;
+			break;
+	}
+
+	// Alpha test
+	if (flags & PF_Fog)
+	{
+		g_gl.alphaFunc = AF_ALWAYS; // Don't discard zero alpha fragments
+		g_gl.alphaRef = 0.0f;
+	}
+	else
+	{
+		switch (flags & (PF_Blending & ~(PF_Masked | PF_Occlude)))
+		{
+			case PF_Translucent:
+			case PF_Additive:
+			case PF_Subtractive:
+			case PF_ReverseSubtract:
+			case PF_Environment:
+			case PF_Multiplicative:
+			case PF_Invert:
+				g_gl.alphaFunc = AF_NOTEQUAL;
+				g_gl.alphaRef = 0.0f;
+				break;
+			default:
+				g_gl.alphaFunc = AF_GREATER;
+				g_gl.alphaRef = 0.5f;
+				break;
+		}
+	}
+}
+
+// r_opengl.c's SetBlend
+void D3D_SetBlend(FBITFIELD PolyFlags)
+{
+	const FBITFIELD Xor = g_currentPolyFlags ^ PolyFlags;
+
+	if (Xor & (PF_Blending|PF_RemoveYWrap|PF_ForceWrapX|PF_ForceWrapY|PF_Occlude|PF_NoTexture|PF_Modulated|PF_NoDepthTest|PF_Decal|PF_Invisible))
+	{
+		if (Xor & PF_Blending) // if blending mode must be changed
+			SetBlendMode(PolyFlags & PF_Blending);
+
+		if (Xor & PF_NoAlphaTest)
+			g_gl.alphaTest = !(PolyFlags & PF_NoAlphaTest);
+
+		if (Xor & PF_Decal)
+			g_gl.polygonOffset = (PolyFlags & PF_Decal) != 0;
+
+		if (Xor & PF_NoDepthTest)
+			g_gl.depthAlways = (PolyFlags & PF_NoDepthTest) != 0;
+
+		if ((Xor & PF_RemoveYWrap) && (PolyFlags & PF_RemoveYWrap))
+			SetRepeatT(false);
+
+		if ((Xor & PF_ForceWrapX) && (PolyFlags & PF_ForceWrapX))
+			SetRepeatS(true);
+
+		if ((Xor & PF_ForceWrapY) && (PolyFlags & PF_ForceWrapY))
+			SetRepeatT(true);
+
+		if (Xor & PF_Modulated)
+			g_gl.texEnv = (PolyFlags & PF_Modulated) ? TE_MODULATE : TE_REPLACE;
+
+		if (Xor & PF_Occlude) // depth test but (no) depth write
+			g_gl.depthMask = (PolyFlags & PF_Occlude) != 0;
+
+		if (Xor & PF_Invisible)
+		{
+			if (PolyFlags & PF_Invisible)
+			{
+				g_gl.blendSrc = BF_ZERO; // transparent blending
+				g_gl.blendDst = BF_ONE;
+			}
+			else if ((PolyFlags & PF_Blending) == PF_Masked)
+			{
+				g_gl.blendSrc = BF_SRC_ALPHA;
+				g_gl.blendDst = BF_ZERO;
+			}
+		}
+
+		if (PolyFlags & PF_NoTexture)
+			SetNoTexture(0);
+	}
+	g_currentPolyFlags = PolyFlags;
+}
