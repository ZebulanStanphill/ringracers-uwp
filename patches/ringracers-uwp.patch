+void D3D_ReadRect(INT32 x, INT32 y, INT32 width, INT32 height, INT32 dst_stride, UINT16 *dst_data)
+{
+	if (!g_rt || width <= 0 || height <= 0)
+		return;
+
+	// OpenGL's y goes up from the bottom of the screen
+	const INT32 top = (INT32)g_rtHeight - (y + height);
+	if (x < 0 || top < 0 || x + width > (INT32)g_rtWidth || top + height > (INT32)g_rtHeight)
+	{
+		Log("ReadRect(%d, %d, %d, %d) is outside the %ux%u screen", (int)x, (int)y, (int)width, (int)height, g_rtWidth, g_rtHeight);
+		return;
+	}
+
+	D3D11_TEXTURE2D_DESC desc = {};
+	desc.Width = width;
+	desc.Height = height;
+	desc.MipLevels = 1;
+	desc.ArraySize = 1;
+	desc.Format = g_rtFormat;
+	desc.SampleDesc.Count = 1;
+	desc.Usage = D3D11_USAGE_STAGING;
+	desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+
+	ComPtr<ID3D11Texture2D> staging;
+	if (Failed(g_device->CreateTexture2D(&desc, nullptr, &staging), "CreateTexture2D (ReadRect)"))
+		return;
+
+	D3D11_BOX box = {(UINT)x, (UINT)top, 0, (UINT)(x + width), (UINT)(top + height), 1};
+	g_context->CopySubresourceRegion(staging.Get(), 0, 0, 0, 0, g_rt.Get(), 0, &box);
+
+	D3D11_MAPPED_SUBRESOURCE mapped;
+	if (Failed(g_context->Map(staging.Get(), 0, D3D11_MAP_READ, 0, &mapped), "Map (ReadRect)"))
+		return;
+
+	const bool bgra = g_rtFormat == DXGI_FORMAT_B8G8R8A8_UNORM;
+	UINT8 *rgb = reinterpret_cast<UINT8 *>(dst_data);
+
+	// Top row first, like r_opengl.c leaves it
+	for (INT32 row = 0; row < height; row++)
+	{
+		const UINT8 *source = static_cast<const UINT8 *>(mapped.pData) + (size_t)row * mapped.RowPitch;
+
+		for (INT32 column = 0; column < width; column++)
+		{
+			const UINT8 *pixel = source + column * 4;
+			const UINT8 r = bgra ? pixel[2] : pixel[0], g = pixel[1], b = bgra ? pixel[0] : pixel[2];
+
+			if (dst_stride == width*3)
+			{
+				UINT8 *out = rgb + (size_t)row * dst_stride + column * 3;
+				out[0] = r;
+				out[1] = g;
+				out[2] = b;
+			}
+			else
+				dst_data[row*width + column] = (UINT16)(((r>>3)<<11) | ((g>>2)<<5) | (b>>3));
+		}
+	}
+
+	g_context->Unmap(staging.Get(), 0);
+}
