+void D3D_SetSpecialState(hwdspecialstate_t IdState, INT32 Value)
+{
+	switch (IdState)
+	{
+		case HWD_SET_MODEL_LIGHTING:
+			// Set around each model, so not logged
+			g_modelLighting = Value;
+			break;
+
+		case HWD_SET_SHADERS:
+			if (g_allowShaders != (hwdshaderoption_t)Value)
+				Log("shaders %s", Value == HWD_SHADEROPTION_OFF ? "off" : Value == HWD_SHADEROPTION_ON ? "on" : "on (no custom)");
+			g_allowShaders = (hwdshaderoption_t)Value;
+			break;
+
+		case HWD_SET_TEXTUREFILTERMODE:
+			switch (Value)
+			{
+				case HWD_SET_TEXTUREFILTER_TRILINEAR:
+					g_minFilter = FILTER_LINEAR_MIPMAP_LINEAR;
+					g_magFilter = FILTER_LINEAR;
+					g_mipmap = true;
+					break;
+				case HWD_SET_TEXTUREFILTER_BILINEAR:
+					g_minFilter = g_magFilter = FILTER_LINEAR;
+					g_mipmap = false;
+					break;
+				case HWD_SET_TEXTUREFILTER_POINTSAMPLED:
+					g_minFilter = g_magFilter = FILTER_NEAREST;
+					g_mipmap = false;
+					break;
+				case HWD_SET_TEXTUREFILTER_MIXED1:
+					g_minFilter = FILTER_NEAREST;
+					g_magFilter = FILTER_LINEAR;
+					g_mipmap = false;
+					break;
+				case HWD_SET_TEXTUREFILTER_MIXED2:
+					g_minFilter = FILTER_LINEAR;
+					g_magFilter = FILTER_NEAREST;
+					g_mipmap = false;
+					break;
+				case HWD_SET_TEXTUREFILTER_MIXED3:
+					g_minFilter = FILTER_LINEAR_MIPMAP_LINEAR;
+					g_magFilter = FILTER_NEAREST;
+					g_mipmap = true;
+					break;
+				default:
+					g_magFilter = FILTER_LINEAR;
+					g_minFilter = FILTER_NEAREST;
+			}
+			Log("texture filter mode %d", (int)Value);
+			{
+				CpuTimer timer(g_stats.textureTime);
+				Flush(); //??? if we want to change filter mode by texture, remove this
+			}
+			break;
+
+		case HWD_SET_PALETTE_RENDERING:
+			if (g_paletteRendering != (Value != 0))
+				Log("palette rendering %s", Value ? "on" : "off");
+			g_paletteRendering = Value != 0;
+			g_bound.paletteSrvs[0] = g_bound.paletteSrvs[1] = nullptr;
+			break;
+
+		case HWD_SET_TEXTUREANISOTROPICMODE:
+			g_anisotropicFilter = std::min((int)Value, kMaximumAnisotropy);
+			Log("anisotropic filtering %d", g_anisotropicFilter);
+			{
+				CpuTimer timer(g_stats.textureTime);
+				Flush(); //??? if we want to change filter mode by texture, remove this
+			}
+			break;
+
+		default:
+			break;
+	}
+}
+
+void D3D_DrawModel(model_t *model, INT32 frameIndex, float duration, float tics, INT32 nextFrameIndex, FTransform *pos, float hscale,
+	float vscale, UINT8 flipped, UINT8 hflipped, FSurfaceInfo *Surface)
+{
+	CpuTimer timer(g_stats.drawTime);
+	static float poly[4] = {0, 0, 0, 0};
+	static float tint[4] = {0, 0, 0, 0};
+	static float fade[4] = {0, 0, 0, 0};
+
+	float pol = 0.0f;
+	bool lit = false;
+
+	if (!CanDraw() || model->numMeshes <= 0)
+		return;
+
+	// Affect input model scaling
+	hscale *= 0.5f;
+	vscale *= 0.5f;
+	float scalex = hscale;
+	float scaley = vscale;
+	float scalez = hscale;
+
+	if (duration > 0.0 && tics >= 0.0) // don't interpolate if instantaneous or infinite in length
+	{
+		float newtime = (duration - tics); // + 1;
+
+		pol = newtime / duration;
+
+		if (pol > 1.0f)
+			pol = 1.0f;
+
+		if (pol < 0.0f)
+			pol = 0.0f;
+	}
+
+	poly[0] = Surface->PolyColor.s.red / 255.0f;
+	poly[1] = Surface->PolyColor.s.green / 255.0f;
+	poly[2] = Surface->PolyColor.s.blue / 255.0f;
+	poly[3] = Surface->PolyColor.s.alpha / 255.0f;
+
+	if (g_modelLighting)
+	{
+		if (!g_shadersEnabled)
+		{
+			// Because otherwise, scaling the screen negatively vertically breaks the lighting:
+			// GL_LIGHT0 at (0, 1, 0, 0), a direction, which the modelview matrix takes to eye space
+			const Mat4 &modelview = g_modelview.back();
+			float x = modelview.m[4], y = modelview.m[5], z = modelview.m[6];
+			const float length = sqrtf(x*x + y*y + z*z);
+
+			if (length > 0.0f)
+			{
+				x /= length;
+				y /= length;
+				z /= length;
+			}
+			g_gl.lightDir[0] = x;
+			g_gl.lightDir[1] = y;
+			g_gl.lightDir[2] = z;
+			memcpy(g_gl.material, poly, sizeof g_gl.material);
+			g_gl.lighting = lit = true;
+		}
+	}
+	else
+		SetColor(&Surface->PolyColor.s.red);
+
+	tint[0] = Surface->TintColor.s.red / 255.0f;
+	tint[1] = Surface->TintColor.s.green / 255.0f;
+	tint[2] = Surface->TintColor.s.blue / 255.0f;
+	tint[3] = Surface->TintColor.s.alpha / 255.0f;
+
+	fade[0] = Surface->FadeColor.s.red / 255.0f;
+	fade[1] = Surface->FadeColor.s.green / 255.0f;
+	fade[2] = Surface->FadeColor.s.blue / 255.0f;
+	fade[3] = Surface->FadeColor.s.alpha / 255.0f;
+
+	FBITFIELD flags = (Surface->PolyFlags | PF_Modulated);
+	if (Surface->PolyFlags & (PF_Additive|PF_Subtractive|PF_ReverseSubtract|PF_Multiplicative))
+		flags |= PF_Occlude;
+	else if (Surface->PolyColor.s.alpha == 0xFF)
+		flags |= (PF_Occlude | PF_Masked);
+
+	D3D_SetBlend(flags);
+	SetUniforms(Surface, poly, tint, fade);
+	SetLightTable(Surface->LightTableId);
+
+	g_gl.cullFace = true;
+
+	// flipped is if the object is vertically flipped
+	// hflipped is if the object is horizontally flipped
+	// pos->flip is if the screen is flipped vertically
+	// pos->mirror is if the screen is flipped horizontally
+	// XOR all the flips together to figure out what culling to use!
+	g_gl.cullFront = (flipped ^ hflipped ^ pos->flip ^ pos->mirror) != 0;
+
+	MatPush(); // should be the same as glLoadIdentity
+	MatTranslate(pos->x, pos->z, pos->y);
+	if (flipped)
+		scaley = -scaley;
+	if (hflipped)
+		scalez = -scalez;
+
+	MatRotate(pos->anglez, 0.0f, 0.0f, -1.0f);
+	MatRotate(pos->anglex, 1.0f, 0.0f, 0.0f);
+	MatRotate(pos->angley, 0.0f, -1.0f, 0.0f);
+
+	if (pos->roll)
+	{
+		MatTranslate(pos->centerx, pos->centery, 0);
+		MatRotate(pos->rollangle, pos->rollx, 0.0f, pos->rollz);
+		MatTranslate(-pos->centerx, -pos->centery, 0);
+	}
+
+	MatScale(scalex, scaley, scalez);
+
+	const bool useTinyFrames = model->meshes[0].tinyframes != NULL;
+
+	if (useTinyFrames)
+		MatScale(1 / 64.0f, 1 / 64.0f, 1 / 64.0f);
+
+	// Don't use the VBO if it does not have the correct texture coordinates.
+	// (Can happen when model uses a sprite as a texture and the sprite changes)
+	const bool useVBO = memcmp(&(model->vbo_max_s), &(model->max_s), sizeof(model->max_s)) == 0
+		&& memcmp(&(model->vbo_max_t), &(model->max_t), sizeof(model->max_t)) == 0;
+
+	for (int i = 0; i < model->numMeshes; i++)
+	{
+		mesh_t *mesh = &model->meshes[i];
+
+		if (mesh->numFrames <= 0)
+			continue;
+
+		if (useTinyFrames)
+		{
+			tinyframe_t *frame = &mesh->tinyframes[frameIndex % mesh->numFrames];
+			tinyframe_t *nextframe = NULL;
+
+			if (nextFrameIndex != -1)
+				nextframe = &mesh->tinyframes[nextFrameIndex % mesh->numFrames];
+
+			if (!nextframe || pol == 0.0f)
+			{
+				auto buffer = useVBO ? g_modelBuffers.find(frame->vboID) : g_modelBuffers.end();
+				if (buffer != g_modelBuffers.end() && buffer->second)
+					DrawMesh(buffer->second.Get(), mesh, true, mesh->numTriangles * 3);
+				else
+				{
+					g_stats.modelFallbacks++;
+					FillTinyVertices(mesh->numVertices, frame->vertices, frame->normals, mesh->uvs);
+					DrawMesh(nullptr, mesh, true, mesh->numTriangles * 3);
+				}
+			}
+			else
+			{
+				g_stats.modelLerps++;
+				g_modelVertices.resize(mesh->numVertices);
+				for (int j = 0; j < mesh->numVertices; j++)
+				{
+					ModelVertex &v = g_modelVertices[j];
+					float *position = &v.x;
+					float *normal = &v.nx;
+
+					for (int k = 0; k < 3; k++)
+					{
+						const int c = j*3 + k;
+						// Interpolate
+						position[k] = (short)(frame->vertices[c] + (pol * (nextframe->vertices[c] - frame->vertices[c])));
+						normal[k] = (char)(frame->normals[c] + (pol * (nextframe->normals[c] - frame->normals[c])));
+					}
+					v.s = mesh->uvs[j*2];
+					v.t = mesh->uvs[j*2 + 1];
+				}
+				DrawMesh(nullptr, mesh, true, mesh->numTriangles * 3);
+			}
+		}
+		else
+		{
+			mdlframe_t *frame = &mesh->frames[frameIndex % mesh->numFrames];
+			mdlframe_t *nextframe = NULL;
+
+			if (nextFrameIndex != -1)
+				nextframe = &mesh->frames[nextFrameIndex % mesh->numFrames];
+
+			if (!nextframe || pol == 0.0f)
+			{
+				auto buffer = useVBO ? g_modelBuffers.find(frame->vboID) : g_modelBuffers.end();
+				if (buffer != g_modelBuffers.end() && buffer->second)
+					DrawMesh(buffer->second.Get(), mesh, false, mesh->numTriangles * 3);
+				else
+				{
+					g_stats.modelFallbacks++;
+					FillVertices(mesh->numTriangles * 3, frame->vertices, frame->normals, mesh->uvs);
+					DrawMesh(nullptr, mesh, false, mesh->numTriangles * 3);
+				}
+			}
+			else
+			{
+				g_stats.modelLerps++;
+				g_modelVertices.resize(mesh->numVertices);
+				for (int j = 0; j < mesh->numVertices; j++)
+				{
+					ModelVertex &v = g_modelVertices[j];
+					float *position = &v.x;
+					float *normal = &v.nx;
+
+					for (int k = 0; k < 3; k++)
+					{
+						const int c = j*3 + k;
+						// Interpolate
+						position[k] = frame->vertices[c] + (pol * (nextframe->vertices[c] - frame->vertices[c]));
+						normal[k] = frame->normals[c] + (pol * (nextframe->normals[c] - frame->normals[c]));
+					}
+					v.s = mesh->uvs[j*2];
+					v.t = mesh->uvs[j*2 + 1];
+				}
+				DrawMesh(nullptr, mesh, false, mesh->numVertices);
+			}
+		}
+	}
+
+	MatPop(); // should be the same as glLoadIdentity
+	g_gl.cullFace = false;
+
+	if (lit)
+		g_gl.lighting = false;
+
+	g_stats.models++;
+}
+
+void D3D_CreateModelVBOs(model_t *model)
+{
+	CpuTimer timer(g_stats.drawTime);
+	int buffers = 0;
+
+	if (!g_device)
+		return;
+
+	for (int i = 0; i < model->numMeshes; i++)
+	{
+		mesh_t *mesh = &model->meshes[i];
+
+		for (int j = 0; j < mesh->numFrames; j++)
+		{
+			unsigned int *vboID;
+
+			if (mesh->frames)
+			{
+				mdlframe_t *frame = &mesh->frames[j];
+				FillVertices(mesh->numTriangles * 3, frame->vertices, frame->normals, mesh->uvs);
+				vboID = &frame->vboID;
+			}
+			else if (mesh->tinyframes)
+			{
+				tinyframe_t *frame = &mesh->tinyframes[j];
+				FillTinyVertices(mesh->numVertices, frame->vertices, frame->normals, mesh->uvs);
+				vboID = &frame->vboID;
+			}
+			else
+				break;
+
+			if (*vboID)
+				g_modelBuffers.erase(*vboID);
+			*vboID = 0;
+
+			StaticBuffer buffer;
+			if (CreateStaticBuffer(g_modelVertices.data(), (UINT)(g_modelVertices.size() * sizeof(ModelVertex)),
+				D3D11_BIND_VERTEX_BUFFER, buffer))
+			{
+				*vboID = g_nextModelBuffer++;
+				g_modelBuffers[*vboID] = buffer;
+				buffers++;
+			}
+		}
+	}
+
+	Log("made %d vertex buffers for model %s", buffers, model->mdlFilename ? model->mdlFilename : "?");
+}
+
+// r_opengl.c's SetTransform
+void D3D_SetTransform(FTransform *stransform)
+{
+	static boolean special_splitscreen;
+	boolean shearing = false;
+	float used_fov;
+
+	MatLoadIdentity();
+
+	if (stransform)
+	{
+		used_fov = stransform->fovxangle;
+		if (stransform->mirror)
+			MatScale(-stransform->scalex, stransform->scaley, -stransform->scalez);
+		else if (stransform->flip)
+			MatScale(stransform->scalex, -stransform->scaley, -stransform->scalez);
+		else
+			MatScale(stransform->scalex, stransform->scaley, -stransform->scalez);
+
+		if (stransform->roll)
+			MatRotate(stransform->rollangle, 0.0f, 0.0f, 1.0f);
+		MatRotate(stransform->anglex       , 1.0f, 0.0f, 0.0f);
+		MatRotate(stransform->angley+270.0f, 0.0f, 1.0f, 0.0f);
+		MatTranslate(-stransform->x, -stransform->z, -stransform->y);
+
+		special_splitscreen = (stransform->splitscreen == 1);
+		shearing = stransform->shearing;
+	}
+	else
+	{
+		used_fov = g_fov;
+		MatScale(1.0f, 1.0f, -1.0f);
+	}
+
+	g_matrixMode = MODE_PROJECTION;
+	MatLoadIdentity();
+
+	// Simulate Software's y-shearing
+	// https://zdoom.org/wiki/Y-shearing
+	if (shearing)
+	{
+		float fdy = stransform->viewaiming * 2;
+		if (stransform->flip)
+			fdy *= -1.0f;
+		MatTranslate(0.0f, -fdy/BASEVIDHEIGHT, 0.0f);
+	}
+
+	if (special_splitscreen)
+	{
+		used_fov = (float)(atan(tan(used_fov*M_PI/360)*0.8)*360/M_PI);
+		Perspective(used_fov, 2.0f);
+	}
+	else
+		Perspective(used_fov, 1.0f);
+
+	g_matrixMode = MODE_MODELVIEW;
+}
+
+INT32 D3D_GetTextureUsed(void)
+{
+	INT32 res = 0;
+
+	for (const auto &entry : g_textures)
+	{
+		const Texture &texture = entry.second;
+
+		if (!texture.listed)
+			continue;
+
+		// Figure out the correct bytes-per-pixel for this texture
+		// I don't know which one the game actually _uses_ but this
+		// follows format2bpp in hw_cache.c
+		int bpp = 1;
+		const UINT32 format = texture.listFormat;
+		if (format == GL_TEXFMT_RGBA)
+			bpp = 4;
+		else if (format == GL_TEXFMT_ALPHA_INTENSITY_88 || format == GL_TEXFMT_AP_88)
+			bpp = 2;
+
+		// Add it up!
+		res += texture.listHeight*texture.listWidth*bpp;
+	}
+
+	return res;
+}
+
+void D3D_PostImgRedraw(float points[SCREENVERTS][SCREENVERTS][2])
+{
+	CpuTimer timer(g_stats.drawTime);
+	const int texsize = ScreenTextureSize();
+
+	// X/Y stretch fix for all resolutions(!)
+	const float xfix = (float)(texsize)/((float)((g_screenWidth)/(float)(SCREENVERTS-1)));
+	const float yfix = (float)(texsize)/((float)((g_screenHeight)/(float)(SCREENVERTS-1)));
+	// Where the screen's top is in the texture, in OpenGL's t
+	const float top = (float)g_screenHeight / texsize;
+
+	g_gl.depthTest = false;
+	g_gl.blend = false;
+
+	// Draw a black square behind the screen texture,
+	// so nothing shows through the edges
+	{
+		static const UINT8 black[4] = {0, 0, 0, 255};
+		const bool texture2D = g_gl.texture2D;
+		FOutVector blackBack[4] = {};
+
+		blackBack[0].x = -16.0f; blackBack[0].y = -16.0f; blackBack[0].z = 6.0f;
+		blackBack[1].x = -16.0f; blackBack[1].y = 16.0f; blackBack[1].z = 6.0f;
+		blackBack[2].x = 16.0f; blackBack[2].y = 16.0f; blackBack[2].z = 6.0f;
+		blackBack[3].x = 16.0f; blackBack[3].y = -16.0f; blackBack[3].z = 6.0f;
+
+		SetColor(black);
+		g_gl.texture2D = false;
+		DrawArrays(LAYOUT_POLY, PRIM_FAN, blackBack, 4);
+		g_gl.texture2D = texture2D;
+		SetColor(kWhite);
+	}
+
+	// The grid, in one draw
+	std::vector<FOutVector> vertices;
+	std::vector<UINT32> indices;
+	vertices.reserve((SCREENVERTS-1) * (SCREENVERTS-1) * 4);
+	indices.reserve((SCREENVERTS-1) * (SCREENVERTS-1) * 6);
+
+	for (int x = 0; x < SCREENVERTS-1; x++)
+	{
+		for (int y = 0; y < SCREENVERTS-1; y++)
+		{
+			// Used for texture coordinates
+			// Annoying magic numbers to scale the square texture to
+			// a non-square screen..
+			const float float_x = (float)(x/(xfix));
+			const float float_y = (float)(y/(yfix));
+			const float float_nextx = (float)(x+1)/(xfix);
+			const float float_nexty = (float)(y+1)/(yfix);
+			const UINT32 first = (UINT32)vertices.size();
+			FOutVector v[4];
+
+			v[0].x = points[x][y][0];
+			v[0].y = points[x][y][1];
+			v[0].s = float_x;
+			v[0].t = top - float_y;
+			v[1].x = points[x][y + 1][0];
+			v[1].y = points[x][y + 1][1];
+			v[1].s = float_x;
+			v[1].t = top - float_nexty;
+			v[2].x = points[x + 1][y + 1][0];
+			v[2].y = points[x + 1][y + 1][1];
+			v[2].s = float_nextx;
+			v[2].t = top - float_nexty;
+			v[3].x = points[x + 1][y][0];
+			v[3].y = points[x + 1][y][1];
+			v[3].s = float_nextx;
+			v[3].t = top - float_y;
+
+			for (FOutVector &vertex : v)
+			{
+				vertex.z = 4.4f;
+				vertices.push_back(vertex);
+			}
+
+			const UINT32 fan[6] = {first, first + 1, first + 2, first, first + 2, first + 3};
+			indices.insert(indices.end(), fan, fan + 6);
+		}
+	}
+
+	if (CanDraw())
+	{
+		const UINT stride = sizeof(FOutVector);
+		const UINT vertexOffset = RingWrite(g_vertexRing, vertices.data(), (UINT)(vertices.size() * stride), stride);
+		const UINT indexOffset = RingWrite(g_indexRing, indices.data(), (UINT)(indices.size() * sizeof(UINT32)), sizeof(UINT32));
+
+		if (vertexOffset != UINT_MAX && indexOffset != UINT_MAX)
+		{
+			BindVertexBuffer(g_vertexRing.buffer.Get(), stride);
+			BindIndexBuffer(g_indexRing.buffer.Get(), DXGI_FORMAT_R32_UINT);
+			ApplyState(LAYOUT_POLY, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+			g_context->DrawIndexed((UINT)indices.size(), indexOffset / sizeof(UINT32), vertexOffset / stride);
+		}
+	}
+
+	g_gl.depthTest = true;
+	g_gl.blend = true;
+	g_stats.screens++;
+}
+
+// Sryder:	This needs to be called whenever the screen changes resolution in order to reset the screen textures to use
+//			a new size
+void D3D_FlushScreenTextures(void)
+{
+	if (g_wipeMask)
+	{
+		D3D11_TEXTURE2D_DESC desc;
+		g_wipeMask->GetDesc(&desc);
+		g_textureBytes -= (UINT64)desc.Width * desc.Height;
+		g_stats.texturesDeleted++;
+	}
+	g_wipeMaskSrv.Reset();
+	g_wipeMask.Reset();
+	g_wipeMaskData.clear();
+	DeleteTextureObject(g_screenTexture);
+	DeleteTextureObject(g_startScreenWipe);
+	DeleteTextureObject(g_endScreenWipe);
+	DeleteTextureObject(g_finalScreenTexture);
+	g_screenTexture = 0;
+	g_startScreenWipe = 0;
+	g_endScreenWipe = 0;
+	g_finalScreenTexture = 0;
+}
