+		int regular, scenery, nothink;
+
+		I_OutputMsg("UWP perf:   %.1f tics/s; logic %.1f ms per tic (players %.1f, thinkers %.1f, Lua %.1f, ACS %.1f), bots %.1f ms per tic\n",
