 set(SRB2_HAVE_THREADS ON)
@@ -933,15 +951,17 @@ if("${CMAKE_SYSTEM_NAME}" STREQUAL Windows AND NOT "${SRB2_CONFIG_INTERNAL_LIBRA
 
