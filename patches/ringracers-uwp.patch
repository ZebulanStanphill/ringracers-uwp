+// The texture coordinates of the screen in its texture, in OpenGL's t
+void ScreenFix(float fix[8], float *yfix)
+{
+	const int texsize = ScreenTextureSize();
+	const float xfix = 1/((float)(texsize)/((float)((g_screenWidth))));
+	*yfix = 1/((float)(texsize)/((float)((g_screenHeight))));
+
+	fix[0] = 0.0f;
+	fix[1] = 0.0f;
+	fix[2] = 0.0f;
+	fix[3] = *yfix;
+	fix[4] = xfix;
+	fix[5] = *yfix;
+	fix[6] = xfix;
+	fix[7] = 0.0f;
+}
+
+// Draw the last scene under the intermission
+void D3D_DrawIntermissionBG(void)
+{
+	CpuTimer timer(g_stats.drawTime);
+	float fix[8], yfix;
+
+	ScreenFix(fix, &yfix);
+
+	ClearScreenColor();
+	ClearScreenDepth();
+
+	BindTexture(0, g_screenTexture);
+	SetColor(kWhite);
+
+	DrawScreenQuad(kScreenVerts, fix, yfix);
+
+	g_texDownloaded = g_screenTexture;
+	g_stats.screens++;
+}
+
+// [UWP]: Read the RHI's raw mask bytes separately, leaving r_opengl.c's palette-red mask for the fallback.
+bool UploadWipeMask()
+{
+	if (g_wipetype >= 100 || g_wipeframe >= 100)
+		return false;
+	char name[9];
+	snprintf(name, sizeof name, "FADE%02u%02u", (unsigned)g_wipetype, (unsigned)g_wipeframe);
+	const lumpnum_t lump = W_CheckNumForName(name);
+	if (lump == LUMPERROR)
+		return false;
+
+	const size_t size = W_LumpLength(lump);
+	UINT width, height;
+	switch (size)
+	{
+		case 256000: width = 640; height = 400; break;
+		case 64000: width = 320; height = 200; break;
+		case 16000: width = 160; height = 100; break;
+		case 4000: width = 80; height = 50; break;
+		default: return false;
+	}
+
+	D3D11_TEXTURE2D_DESC old = {};
+	if (g_wipeMask)
+		g_wipeMask->GetDesc(&old);
+	if (!g_wipeMask || old.Width != width || old.Height != height)
+	{
+		D3D11_TEXTURE2D_DESC desc = {};
+		desc.Width = width;
+		desc.Height = height;
+		desc.MipLevels = desc.ArraySize = 1;
+		desc.Format = DXGI_FORMAT_R8_UNORM;
+		desc.SampleDesc.Count = 1;
+		desc.Usage = D3D11_USAGE_DEFAULT;
+		desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+		ComPtr<ID3D11Texture2D> texture;
+		ComPtr<ID3D11ShaderResourceView> srv;
+		if (Failed(g_device->CreateTexture2D(&desc, nullptr, &texture), "CreateTexture2D (wipe mask)")
+			|| Failed(g_device->CreateShaderResourceView(texture.Get(), nullptr, &srv), "CreateShaderResourceView (wipe mask)"))
+			return false;
+		g_textureBytes -= (UINT64)old.Width * old.Height;
+		g_textureBytes += size;
+		if (g_wipeMask)
+			g_stats.texturesDeleted++;
+		g_wipeMask = texture;
+		g_wipeMaskSrv = srv;
+		g_stats.texturesCreated++;
+	}
+
+	g_wipeMaskData.resize(size);
+	W_ReadLump(lump, g_wipeMaskData.data());
+	g_context->UpdateSubresource(g_wipeMask.Get(), 0, nullptr, g_wipeMaskData.data(), width, 0);
+	g_stats.textureUploads++;
+	g_stats.textureUploadBytes += size;
+	return true;
+}
+
+// [UWP]: Match hwr2/postprocess_wipe.cpp and its shader instead of r_opengl.c's simple crossfade.
+bool DrawWipeFull()
+{
+	Texture *start = FindTexture(g_wipereverse ? g_endScreenWipe : g_startScreenWipe);
+	Texture *end = FindTexture(g_wipereverse ? g_startScreenWipe : g_endScreenWipe);
+	if (!CanDraw() || !start || !end || !start->srv || !end->srv
+		|| !g_vertexShaders[VS_FULLSCREEN] || !g_pixelShaders[PS_WIPEFULL]
+		|| !g_opaqueBlend || !g_noDepth || !g_noCull || !g_defaultSampler
+		|| g_screenWidth <= 0 || g_screenHeight <= 0)
+		return false;
+
+	if (!g_wipeConstants)
+	{
+		D3D11_BUFFER_DESC desc = {};
+		desc.ByteWidth = sizeof(WipeConstants);
+		desc.Usage = D3D11_USAGE_DYNAMIC;
+		desc.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+		desc.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+		if (Failed(g_device->CreateBuffer(&desc, nullptr, &g_wipeConstants), "CreateBuffer (wipe constants)"))
+			return false;
+	}
+	if (!UploadWipeMask())
+		return false;
+
+	WipeConstants c = {};
+	c.screenSize[0] = (float)g_screenWidth;
+	c.screenSize[1] = (float)g_screenHeight;
+	c.screenFix[0] = (float)g_screenWidth / ScreenTextureSize();
+	c.screenFix[1] = (float)g_screenHeight / ScreenTextureSize();
+	c.mode = F_WipeIsToBlack(g_wipemode) ? 2 : F_WipeIsToWhite(g_wipemode) ? 3 : F_WipeIsToInvert(g_wipemode) ? 1 : 0;
+	c.wiggle = g_wipeencorewiggle;
+	c.reverse = g_wipereverse;
+	D3D11_MAPPED_SUBRESOURCE mapped;
+	if (Failed(g_context->Map(g_wipeConstants.Get(), 0, D3D11_MAP_WRITE_DISCARD, 0, &mapped), "Map wipe constants"))
+		return false;
+	memcpy(mapped.pData, &c, sizeof c);
+	g_context->Unmap(g_wipeConstants.Get(), 0);
+	g_stats.constantUpdates++;
+
+	ClearScreenColor();
+	ClearScreenDepth();
+	ID3D11Buffer *constants = g_wipeConstants.Get();
+	ID3D11ShaderResourceView *screens[2] = {start->srv.Get(), end->srv.Get()};
+	ID3D11ShaderResourceView *mask = g_wipeMaskSrv.Get();
+	ID3D11SamplerState *sampler = g_defaultSampler.Get();
+	D3D11_VIEWPORT viewport = {0.0f, 0.0f, c.screenSize[0], c.screenSize[1], 0.0f, 1.0f};
+	g_context->PSSetConstantBuffers(1, 1, &constants);
+	g_context->PSSetShaderResources(0, 2, screens);
+	// t2-t4 are reserved for palette rendering.
+	g_context->PSSetShaderResources(5, 1, &mask);
+	g_context->PSSetSamplers(0, 1, &sampler);
+	g_context->IASetInputLayout(nullptr);
+	g_context->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+	g_context->VSSetShader(g_vertexShaders[VS_FULLSCREEN].Get(), nullptr, 0);
+	g_context->PSSetShader(g_pixelShaders[PS_WIPEFULL].Get(), nullptr, 0);
+	g_context->OMSetBlendState(g_opaqueBlend.Get(), nullptr, 0xFFFFFFFF);
+	g_context->OMSetDepthStencilState(g_noDepth.Get(), 0);
+	g_context->RSSetState(g_noCull.Get());
+	g_context->RSSetViewports(1, &viewport);
+	g_context->Draw(3, 0);
+	g_stats.shaderChanges += 2;
+	g_stats.blendChanges++;
+	g_stats.depthChanges++;
+	g_stats.rasterChanges++;
+	g_stats.textureBinds += 3;
+	g_stats.vertices += 3;
+
+	// Release the mask before the next upload and invalidate state changed outside ApplyState.
+	ID3D11ShaderResourceView *none[2] = {};
+	g_context->PSSetShaderResources(0, 2, none);
+	g_context->PSSetShaderResources(5, 1, none);
+	const Bound previous = g_bound;
+	g_bound = Bound();
+	g_bound.vertexBuffer = previous.vertexBuffer;
+	g_bound.stride = previous.stride;
+	g_bound.indexBuffer = previous.indexBuffer;
+	g_bound.indexFormat = previous.indexFormat;
+	g_bound.samplers[0] = sampler;
+	g_bound.samplers[1] = previous.samplers[1];
+	g_bound.paletteSrvs[0] = previous.paletteSrvs[0];
+	g_bound.paletteSrvs[1] = previous.paletteSrvs[1];
+	return true;
+}
+
+// Do screen fades!
+void D3D_DoScreenWipe(void)
+{
+	CpuTimer timer(g_stats.drawTime);
+	g_presentImmediately = true; // applies to both the full wipe and the fallback below
+	if (DrawWipeFull())
+	{
+#ifdef _UWP
+		UWPTraceFade("D3D_DoScreenWipe path=full mode=%u type=%u maskframe=%u reverse=%d wiggle=%u", g_wipemode, g_wipetype, g_wipeframe, g_wipereverse, g_wipeencorewiggle);
+#endif
+		g_texDownloaded = g_endScreenWipe;
+		g_stats.screens++;
+		return;
+	}
+#ifdef _UWP
+	UWPTraceFade("D3D_DoScreenWipe path=fallback mode=%u type=%u maskframe=%u reverse=%d wiggle=%u", g_wipemode, g_wipetype, g_wipeframe, g_wipereverse, g_wipeencorewiggle);
+#endif
+	// Keep the two-pass Legacy GL wipe if the full wipe's resources are unavailable.
+	float fix[8], yfix;
+	const UINT32 fademaskdownloaded = g_texDownloaded; // the fade mask that has been set
+
+	ScreenFix(fix, &yfix);
+
+	ClearScreenColor();
+	ClearScreenDepth();
+
+	D3D_SetBlend(PF_Modulated|PF_NoDepthTest);
+	g_gl.texture2D = true;
+
+	// Draw the original screen
+	BindTexture(0, g_startScreenWipe);
+	SetColor(kWhite);
+	DrawScreenQuad(kScreenVerts, fix, yfix);
+
+	D3D_SetBlend(PF_Modulated|PF_Translucent|PF_NoDepthTest);
+
+	// Draw the end screen that fades in
+	g_gl.texture2D = true;
+	BindTexture(0, g_endScreenWipe);
+	g_gl.texEnv = TE_REPLACE;
+
+	// The fade mask, on the second texture unit, modulated
+	BindTexture(1, fademaskdownloaded);
+	DrawScreenQuad(kScreenVerts, fix, yfix, g_program < 0);
+
+	g_texDownloaded = g_endScreenWipe;
+	g_stats.screens++;
+}
