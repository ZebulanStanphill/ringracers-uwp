@@ -1948,7 +1948,25 @@ void CON_SetLoadingProgress(con_loadprogress_t newStep)
 	con_startup_loadprogress = newStep;
 
 	if (con_startup_loadprogress <= LOADED_ALLDONE)
+	{
+#ifdef _UWP
+		// [UWP]: Time each step, and the time spent logging, to see what makes startup slow on Xbox
+		static precise_t loadstart = 0;
+		static precise_t logstart = 0;
+
+		if (!loadstart)
+		{
+			loadstart = I_GetPreciseTime();
+			logstart = i_uwplogtime;
+		}
+
+		CONS_Printf("LOADING UPDATE - %s (%.1f s, %.1f s of it logging)\n", CON_LoadingStrings[con_startup_loadprogress],
+			(double)(I_GetPreciseTime() - loadstart) / I_GetPrecisePrecision(),
+			(double)(i_uwplogtime - logstart) / I_GetPrecisePrecision());
+#else
 		CONS_Printf("LOADING UPDATE - %s\n", CON_LoadingStrings[con_startup_loadprogress]);
+#endif
+	}
 
 	if (con_startup_loadprogress < LOADED_ISTARTUPGRAPHICS) // rendering not possible?
 		return;
diff --git a/src/core/thread_pool.cpp b/src/core/thread_pool.cpp
index 8a434ba63..0e3c54d64 100644
--- a/src/core/thread_pool.cpp
+++ b/src/core/thread_pool.cpp
@@ -24,6 +24,11 @@
 #include "../cxxutil.hpp"
 #include "../m_argv.h"
 
+#ifdef _UWP
+extern "C" void I_OutputMsg(const char *error, ...);
+extern "C" unsigned int I_UWPUsableProcessors(void);
+#endif
+
 using namespace srb2;
 
 static void do_work(ThreadPool::Task& work)
@@ -301,6 +306,15 @@ void I_ThreadPoolInit(void)
 {
 	SRB2_ASSERT(g_main_threadpool == nullptr);
 	size_t thread_count = std::min(static_cast<unsigned int>(9), std::thread::hardware_concurrency());
+#ifdef _UWP
+	// [UWP]: Limit workers when Xbox marks processors as the game's own. Some launches don't mark any, so keep the
+	// upstream hardware count then; counting only the unallocated processors picked the system's two cores.
+	const unsigned int usable = I_UWPUsableProcessors();
+	if (usable)
+	{
+		thread_count = std::min(static_cast<unsigned int>(9), usable);
+	}
+#endif
 	if (thread_count > 1)
 	{
 		// The main thread will act as a worker when waiting for pool idle
@@ -316,6 +330,11 @@ void I_ThreadPoolInit(void)
 	{
 		g_main_threadpool = std::make_unique<ThreadPool>(thread_count);
 	}
+
+#ifdef _UWP
+	I_OutputMsg("UWP: %u hardware threads, %u marked as the game's, %zu thread pool workers\n",
+		std::thread::hardware_concurrency(), usable, M_CheckParm("-singlethreaded") ? (size_t)0 : thread_count);
+#endif
 }
 
 void I_ThreadPoolShutdown(void)
