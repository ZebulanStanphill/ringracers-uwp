+			limit >> 20, usage >> 20, (limit > usage ? limit - usage : 0) >> 20, resources);
+	}
+	else
+		I_OutputMsg("UWP: process memory budget unavailable (HRESULT 0x%08x); launch resources unknown\n", (unsigned)result);
+}
