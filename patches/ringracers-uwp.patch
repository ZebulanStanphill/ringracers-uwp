+// ==========================================================================
+//                                                                    LOGGING
+// ==========================================================================
+
+void Log(const char *format, ...)
+{
+	char message[2048];
+	va_list args;
+
+	va_start(args, format);
+	vsnprintf(message, sizeof message, format, args);
+	va_end(args);
+	I_OutputMsg("UWP D3D11: %s\n", message);
+}
+
+// Logs something the driver doesn't do like r_opengl.c, the first time it happens
+#define LOG_ONCE(...) do { static bool logged = false; if (!logged) { logged = true; Log(__VA_ARGS__); } } while (0)
+
+ComPtr<ID3D11Device> g_device;
+ComPtr<ID3D11DeviceContext> g_context;
+int g_errors = 0;
+bool g_deviceLost = false;
+
+bool Failed(HRESULT hr, const char *what)
+{
+	if (SUCCEEDED(hr))
+		return false;
+
+	g_errors++;
+	if (g_errors <= 50 || g_errors % 1000 == 0)
+	{
+		const HRESULT reason = g_device ? g_device->GetDeviceRemovedReason() : S_OK;
+		Log("%s failed: 0x%08X (device removed reason 0x%08X; error %d)", what, (unsigned)hr, (unsigned)reason, g_errors);
+	}
+	return true;
+}
+
+// What the driver did since the last perf summary
+struct Stats
+{
+	int frames;
+	int polygons, batches, skies, models, lines, screens;
+	INT64 vertices, indices;
+	int constantUpdates;
+	INT64 uploadBytes;
+	int ringWraps;
+	int shaderChanges, blendChanges, depthChanges, rasterChanges, textureBinds;
+	int texturesCreated, textureUploads, texturesDeleted, flushes;
+	INT64 textureUploadBytes;
+	int modelFallbacks, modelLerps;
+	int skyBuilds;
+	int lightTablesCreated, lightTablesUpdated;
+	precise_t paletteTime;
+	precise_t drawTime, textureTime;
+	precise_t copyTime, waitTime, worstWait, glTime, swapTime;
+	double gpuMs, worstGpuMs;
+	int gpuFrames;
+};
+Stats g_stats;
+
+// The first frames, to diagnose startup
+int g_tracedFrames = 0;
+constexpr int kTraceFrames = 3;
+
+// Adds the time until the end of the scope to a total
+struct CpuTimer
+{
+	precise_t &total;
+	precise_t start;
+
+	explicit CpuTimer(precise_t &t) : total(t), start(I_GetPreciseTime()) {}
+	~CpuTimer() { total += I_GetPreciseTime() - start; }
+};
+
+double PreciseToMs(precise_t t)
+{
+	return t * 1000.0 / I_GetPrecisePrecision();
+}
+
+// DXGI's usage is for the process on this adapter, including ANGLE, rather than just this device.
+ComPtr<IDXGIAdapter3> g_memoryAdapter;
+DXGI_QUERY_VIDEO_MEMORY_INFO g_localMemory = {};
+bool g_localMemoryValid = false;
+bool g_textureFlushRequested = false;
+bool g_budgetTextureFlush = false;
+precise_t g_lastTextureFlush = 0;
+bool g_textureFlushed = false;
+
+bool QueryMemory(DXGI_MEMORY_SEGMENT_GROUP segment, DXGI_QUERY_VIDEO_MEMORY_INFO &info)
+{
+	info = {};
+	if (!g_memoryAdapter)
+		return false;
+	const HRESULT hr = g_memoryAdapter->QueryVideoMemoryInfo(0, segment, &info);
+	if (SUCCEEDED(hr))
+		return true;
+	if (segment == DXGI_MEMORY_SEGMENT_GROUP_LOCAL)
+		LOG_ONCE("QueryVideoMemoryInfo (local) unavailable: 0x%08X", (unsigned)hr);
+	else
+		LOG_ONCE("QueryVideoMemoryInfo (non-local) unavailable: 0x%08X", (unsigned)hr);
+	return false;
+}
+
+void DescribeMemory(char *text, size_t size, const DXGI_QUERY_VIDEO_MEMORY_INFO &info, bool valid)
+{
+	if (valid)
+		snprintf(text, size, "budget %.1f, usage %.1f, available for reservation %.1f, reservation %.1f MB",
+			info.Budget / 1048576.0, info.CurrentUsage / 1048576.0,
+			info.AvailableForReservation / 1048576.0, info.CurrentReservation / 1048576.0);
+	else
+		snprintf(text, size, "unavailable");
+}
+
+void InitVideoMemory()
+{
+	ComPtr<IDXGIDevice> device;
+	ComPtr<IDXGIAdapter> adapter;
+	if (FAILED(g_device.As(&device)) || FAILED(device->GetAdapter(&adapter)) || FAILED(adapter.As(&g_memoryAdapter)))
+	{
+		LOG_ONCE("video memory budgets unavailable (IDXGIAdapter3 not supported)");
+		return;
+	}
+	g_localMemoryValid = QueryMemory(DXGI_MEMORY_SEGMENT_GROUP_LOCAL, g_localMemory);
+	DXGI_QUERY_VIDEO_MEMORY_INFO nonlocal;
+	const bool nonlocalValid = QueryMemory(DXGI_MEMORY_SEGMENT_GROUP_NON_LOCAL, nonlocal);
+	char localText[192], nonlocalText[192];
+	DescribeMemory(localText, sizeof localText, g_localMemory, g_localMemoryValid);
+	DescribeMemory(nonlocalText, sizeof nonlocalText, nonlocal, nonlocalValid);
+	Log("video memory: local %s; non-local %s", localText, nonlocalText);
+}
+
+// One local query per Present, also on frames whose copy times out. Warnings reuse this snapshot.
+void CheckVideoMemory()
+{
+	g_localMemoryValid = QueryMemory(DXGI_MEMORY_SEGMENT_GROUP_LOCAL, g_localMemory);
+	g_textureFlushRequested = g_localMemoryValid && g_localMemory.CurrentUsage > g_localMemory.Budget;
+}
+
+// Shared limiter for both stall warnings: at most one line per second, with suppressed events counted.
+void WarnGpuStall(const char *event, double ms)
+{
+	static precise_t lastWarning = 0;
+	static bool warned = false;
+	static UINT64 suppressed = 0;
+	const precise_t now = I_GetPreciseTime();
+	if (warned && now - lastWarning < I_GetPrecisePrecision())
+	{
+		suppressed++;
+		return;
+	}
+	if (g_localMemoryValid)
+		Log("%s (%.1f ms); local usage %.1f MB, budget %.1f MB; %llu stall warnings suppressed",
+			event, ms, g_localMemory.CurrentUsage / 1048576.0, g_localMemory.Budget / 1048576.0,
+			(unsigned long long)suppressed);
+	else
+		Log("%s (%.1f ms); local usage/budget unavailable; %llu stall warnings suppressed",
+			event, ms, (unsigned long long)suppressed);
+	lastWarning = now;
+	warned = true;
+	suppressed = 0;
+}
