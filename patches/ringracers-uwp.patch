 			if (lastdraw)
@@ -903,6 +916,10 @@ void D_SRB2Loop(void)
 	S_SetMusicVolume();
 	S_SetSfxVolume();
 
+#ifdef _UWP
+	I_UWPStartProfiler();
+#endif
+
 	for (;;)
 	{
 		// capbudget is the minimum precise_t duration of a single loop iteration
@@ -922,6 +939,9 @@ void D_SRB2Loop(void)
 
 		bool ranwipe = false;
 		bool world = false;
+#ifdef _UWP
+		bool displayed = false;
+#endif
 
 		I_UpdateTime();
 
@@ -954,6 +974,9 @@ void D_SRB2Loop(void)
 		renderisnewtic = (realtics > 0 || singletics);
 
 		bool timeisprogressing = (!(paused || P_AutoPause()) && !hu_stopped);
+#ifdef _UWP
+		i_uwpprofinlevel = gamestate == GS_LEVEL && timeisprogressing;
+#endif
 
 		if (renderisnewtic)
 		{
@@ -1067,6 +1090,9 @@ void D_SRB2Loop(void)
 			}
 
 			ranwipe = D_Display(world);
+#ifdef _UWP
+			displayed = true;
+#endif
 		}
 
 #ifdef HWRENDER
@@ -1183,12 +1209,21 @@ void D_SRB2Loop(void)
 			skiplaggyworld = false;
 		}
 
+#ifdef _UWP
+		const precise_t worktime = finishprecise - enterprecise;
+#endif
+
 		if (!singletics)
 		{
 			INT64 elapsed = (INT64)(finishprecise - enterprecise);
 
+#ifndef _UWP
 			// in the case of "match refresh rate" + vsync, don't sleep at all
 			const boolean vsync_with_match_refresh = cv_vidwait.value && cv_fpscap.value == 0;
+#else
+			// [UWP]: This is usually a good idea but for some reason no sleep really screws up the frame timings on xbox
+			const boolean vsync_with_match_refresh = false;
+#endif
 
 			if (elapsed > 0 && (INT64)capbudget > elapsed && !vsync_with_match_refresh)
 			{
@@ -1199,6 +1234,10 @@ void D_SRB2Loop(void)
 		finishprecise = I_GetPreciseTime();
 		deltasecs = (double)((INT64)(finishprecise - enterprecise)) / I_GetPrecisePrecision();
 		deltatics = deltasecs * NEWTICRATE;
+
+#ifdef _UWP
+		PS_UWPAddLoop(worktime, displayed);
+#endif
 	}
 }
 
