+		&& HWR_LightTableMatches(&gl_lighttables[gl_lastlighttable], colormap, source))
+		return gl_lighttables[gl_lastlighttable].id;
+
+	for (i = 0; i < gl_numlighttables; i++)
+	{
+		table = &gl_lighttables[i];
