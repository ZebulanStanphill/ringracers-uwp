+	using GetIntegervFn = void (WINAPI *)(unsigned int, int *);
+	GetIntegervFn getintegerv = reinterpret_cast<GetIntegervFn>(SDL_GL_GetProcAddress("glGetIntegerv"));
+	static boolean done = false;
