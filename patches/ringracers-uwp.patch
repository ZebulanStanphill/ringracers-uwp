+boolean D3D11_Surface(INT32 w, INT32 h)
+{
+	static bool first = true;
+
+	if (first)
+	{
+		Log("setting up a %dx%d screen", (int)w, (int)h);
+		first = false;
+	}
+
+	if (!g_device)
+	{
+		Log("no device to draw a %dx%d screen with", (int)w, (int)h);
+		return false;
+	}
+
+	glanisotropicmode_cons_t[1].value = kMaximumAnisotropy;
+	SDL_GL_SetSwapInterval(cv_vidwait.value ? 1 : 0);
+	g_present.vsync = cv_vidwait.value != 0;
+	g_present.vsyncSet = true;
+
+	SetModelView(w, h);
+	SetStates();
+	ClearScreenColor();
+	ClearScreenDepth();
+
+	HWR_Startup();
+	return true;
+}
+
+void D3D11_FinishUpdate(INT32 waitvbl)
+{
+	const bool vsync = waitvbl != 0;
+
+	if (!g_present.vsyncSet || g_present.vsync != vsync)
+	{
+		SDL_GL_SetSwapInterval(vsync ? 1 : 0);
+		g_present.vsync = vsync;
+		g_present.vsyncSet = true;
+	}
+
+#ifdef _UWP
+	g_traceCopied = g_traceShown = -1;
+	g_traceCopyFrame = g_traceShowFrame = 0;
+#endif
+	if (!g_context || !g_rt || g_deviceLost)
+		return;
+
+	Present();
+	g_stats.frames++;
+
+	if (g_tracedFrames < kTraceFrames)
+	{
+		g_tracedFrames++;
+		Log("frame %d done: %d textures (%.1f MB), %d errors", g_tracedFrames, (int)g_textures.size(),
+			g_textureBytes / 1048576.0, g_errors);
+	}
+
+	const HRESULT removed = g_device->GetDeviceRemovedReason();
+	if (FAILED(removed))
+	{
+		g_deviceLost = true;
+		Log("the device was removed: 0x%08X", (unsigned)removed);
+		I_Error("Legacy GL's Direct3D 11 device stopped working (0x%08X).\nSwitch the renderer to Software in the config if it keeps happening.",
+			(unsigned)removed);
+	}
+
+	// Draws after this start from the whole screen, like after OglSdlFinishUpdate
+	D3D_GClipRect(0, 0, g_screenWidth, g_screenHeight, NZCLIP_PLANE);
+}
+
+boolean D3D11_TakeTextureFlushRequest(void)
+{
+	const bool requested = g_textureFlushRequested;
+	g_textureFlushRequested = false;
+	if (!requested)
+		return false;
+	const precise_t now = I_GetPreciseTime();
+	if (g_textureFlushed && now - g_lastTextureFlush < 5 * I_GetPrecisePrecision())
+		return false;
+	g_lastTextureFlush = now;
+	g_textureFlushed = true;
+	g_budgetTextureFlush = true; // Flush logs once the driver has actually released the textures
+	return true;
+}
+
+#ifdef _UWP
+void D3D11_GetPresentTrace(INT32 *copied, INT32 *shown, UINT32 *copyframe, UINT32 *showframe)
+{
+	*copied = g_traceCopied; *shown = g_traceShown;
+	*copyframe = g_traceCopyFrame; *showframe = g_traceShowFrame;
+}
+#endif
+
+void D3D11_LogPerf(double seconds)
+{
+	const Stats &s = g_stats;
+	const double n = s.frames ? s.frames : 1;
+
+	if (!g_device)
+		return;
+
+	I_OutputMsg("UWP perf:   D3D11: %.1f frames/s; per frame %.0f polygons, %.0f batches, %.1f models, %.1f skies (%.1f rebuilt), %.1f lines, %.1f screen copies or draws\n",
+		s.frames / seconds, s.polygons / n, s.batches / n, s.models / n, s.skies / n, s.skyBuilds / n, s.lines / n, s.screens / n);
+	I_OutputMsg("UWP perf:   D3D11: per frame %.0f vertices, %.0f indices, %.0f KB uploaded, %.0f constant updates, %.0f shader, %.0f blend, %.0f depth, %.0f raster changes, %.0f texture binds; %d buffer wraps\n",
+		s.vertices / n, s.indices / n, s.uploadBytes / n / 1024.0, s.constantUpdates / n, s.shaderChanges / n,
+		s.blendChanges / n, s.depthChanges / n, s.rasterChanges / n, s.textureBinds / n, s.ringWraps);
+	I_OutputMsg("UWP perf:   D3D11: textures: %d created, %d uploads (%.1f MB), %d deleted, %d flushes; %d alive (%.1f MB); models: %d drawn without buffers, %d interpolated\n",
+		s.texturesCreated, s.textureUploads, s.textureUploadBytes / 1048576.0, s.texturesDeleted, s.flushes,
+		(int)g_textures.size(), g_textureBytes / 1048576.0, s.modelFallbacks, s.modelLerps);
+	I_OutputMsg("UWP perf:   D3D11: CPU per frame: drawing %.2f ms, textures %.2f ms; presenting: copy %.2f, wait %.2f (worst %.2f), GL %.2f, swap %.2f ms; GPU %.2f ms per frame (worst %.2f, %d timed); %s; %d errors\n",
+		PreciseToMs(s.drawTime) / n, PreciseToMs(s.textureTime) / n, PreciseToMs(s.copyTime) / n, PreciseToMs(s.waitTime) / n,
+		PreciseToMs(s.worstWait), PreciseToMs(s.glTime) / n, PreciseToMs(s.swapTime) / n,
+		s.gpuFrames ? s.gpuMs / s.gpuFrames : 0.0, s.worstGpuMs, s.gpuFrames,
+		g_present.shared ? "shared texture" : "read back", g_errors);
+
+	if (g_paletteRendering || s.lightTablesCreated)
+	{
+		I_OutputMsg("UWP perf:   D3D11: palette rendering %s; last step %.2f ms per frame; light tables: %d alive, %d created, %d updated\n",
+			g_paletteRendering ? "on" : "off", PreciseToMs(s.paletteTime) / n, (int)g_lightTables.size(),
+			s.lightTablesCreated, s.lightTablesUpdated);
+	}
+
+	DXGI_QUERY_VIDEO_MEMORY_INFO local, nonlocal;
+	const bool localValid = QueryMemory(DXGI_MEMORY_SEGMENT_GROUP_LOCAL, local);
+	const bool nonlocalValid = QueryMemory(DXGI_MEMORY_SEGMENT_GROUP_NON_LOCAL, nonlocal);
+	char localText[192], nonlocalText[192];
+	DescribeMemory(localText, sizeof localText, local, localValid);
+	DescribeMemory(nonlocalText, sizeof nonlocalText, nonlocal, nonlocalValid);
+	UINT64 staticBytes = 0;
+	size_t staticCount = 0;
+	const auto countBuffer = [&](const StaticBuffer &buffer)
+	{
+		if (buffer)
+		{
+			staticBytes += buffer.bytes;
+			staticCount++;
+		}
+	};
+	countBuffer(g_fanIndices);
+	countBuffer(g_skyBuffer);
+	for (const auto &entry : g_modelBuffers)
+		countBuffer(entry.second);
+	for (const auto &entry : g_meshIndexBuffers)
+		countBuffer(entry.second);
+	// Approximate allocation sizes, without querying resources every frame or double-counting screen textures.
+	UINT64 targets = (g_rt ? (UINT64)g_rtWidth * g_rtHeight * 4 : 0)
+		+ (g_depth ? (UINT64)g_rtWidth * g_rtHeight * 4 : 0);
+	if (g_postTexture)
+	{
+		D3D11_TEXTURE2D_DESC desc;
+		g_postTexture->GetDesc(&desc);
+		targets += (UINT64)desc.Width * desc.Height * 4;
+	}
+	for (const auto &slot : g_present.slots)
+		if (slot.texture)
+			targets += (UINT64)g_present.width * g_present.height * 4;
+	I_OutputMsg("UWP perf:   D3D11: memory: local %s; non-local %s; tracked textures %.1f MB; model/static buffers %.1f MB (%llu alive); rings %.1f MB; render targets/present slots ~%.1f MB\n",
+		localText, nonlocalText, g_textureBytes / 1048576.0, staticBytes / 1048576.0,
+		(unsigned long long)staticCount, ((UINT64)g_vertexRing.size + g_indexRing.size) / 1048576.0,
+		targets / 1048576.0);
+
+	memset(&g_stats, 0, sizeof g_stats);
+}
