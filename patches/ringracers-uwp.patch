+/// \file r_d3d11.cpp
+/// \brief [UWP]: Legacy GL's driver for Direct3D 11, presented through ANGLE
+///
+/// Legacy GL draws through struct hwdriver_s, whose only implementation, r_opengl.c, needs desktop OpenGL's fixed
+/// function, which ANGLE (OpenGL ES 2 on Direct3D 11) doesn't have. This implements the same functions with
+/// Direct3D 11, following r_opengl.c call for call: it keeps the OpenGL state r_opengl.c would have set (matrices,
+/// blending, texture bindings and parameters, shader uniforms) and draws with that, so its quirks carry over too.
+///
+/// It renders with its own device to a texture the size of the game's screen. Each frame is copied to a texture
+/// shared with ANGLE's device, which draws it to the window through OpenGL ES, a frame later so the copy has
+/// finished. If ANGLE can't open the shared texture, the frame is read back and uploaded instead.
+
+#define NOMINMAX
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
