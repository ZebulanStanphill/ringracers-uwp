+static boolean UWPHasAppMemoryBudget(int isXbox, UINT64 limit)
+{
+	// Foreground Xbox apps get 1 GiB; games get 5 GiB. Do not infer a mode
+	// from a failed query, a zero budget, or a non-Xbox device.
+	return isXbox && limit > 0 && limit <= (UINT64(1) << 30);
+}
+
+boolean I_UWPAskSkipAssetCheck(void)
+{
+	const SDL_MessageBoxButtonData buttons[] = {
+		{SDL_MESSAGEBOX_BUTTON_RETURNKEY_DEFAULT | SDL_MESSAGEBOX_BUTTON_ESCAPEKEY_DEFAULT, 0, "Check files"},
+		{0, 1, "Skip check"},
+	};
+	const char *question =
+		"Check the game files in E:\\ringracers before loading?\n\n"
+		"Checking reads every file in full, which can take a while from a USB drive. "
+		"Skipping loads faster, but won't catch damaged or outdated files.";
+	char message[512];
+	UINT64 limit = 0, usage = 0;
+	int isXbox = 0;
+	const int result = I_UWPGetMemoryBudget(&limit, &usage, &isXbox);
+	const boolean appmode = result == 0 && UWPHasAppMemoryBudget(isXbox, limit);
+	SDL_MessageBoxData data = {};
+	int button = 0;
+
+	data.flags = appmode ? SDL_MESSAGEBOX_WARNING : SDL_MESSAGEBOX_INFORMATION;
+	data.title = "Dr. Robotnik's Ring Racers";
+	data.message = question;
+	if (appmode)
+	{
+		// Put the warning first: Xbox may truncate long message dialogs.
+		snprintf(message, sizeof message,
+			"App mode detected: Xbox limits performance and memory.\n"
+			"Close the game, set App type to Game in Dev Home, then relaunch.\n\n%s", question);
+		data.message = message;
+		I_OutputMsg("UWP: App-mode resources detected at the file-check prompt (%llu MB budget)\n", limit >> 20);
+	}
+	else if (result != 0)
+		I_OutputMsg("UWP: could not check launch resources for the file-check prompt (HRESULT 0x%08x)\n", (unsigned)result);
+	data.numbuttons = (int)SDL_arraysize(buttons);
+	data.buttons = buttons;
+
+	if (SDL_ShowMessageBox(&data, &button) < 0)
+		return false;
+
+	return button == 1;
+}
