+
+bool CreateDeviceObjects();
+
+boolean D3D_Init(void)
+{
+	if (g_device)
+		return true;
+
+	Log("starting Legacy GL's Direct3D 11 driver");
+
+	// On the same adapter as ANGLE, which the window's frames go through
+	ComPtr<IDXGIAdapter> adapter;
+	if (LoadEgl() && egl.QueryDisplayAttribEXT && egl.QueryDeviceAttribEXT && egl.GetCurrentDisplay())
+	{
+		EGLAttrib device = 0, d3dDevice = 0;
+		if (egl.QueryDisplayAttribEXT(egl.GetCurrentDisplay(), EGL_DEVICE_EXT, &device) && device
+			&& egl.QueryDeviceAttribEXT(reinterpret_cast<EGLDeviceEXT>(device), EGL_D3D11_DEVICE_ANGLE, &d3dDevice) && d3dDevice)
+		{
+			ID3D11Device *angleDevice = reinterpret_cast<ID3D11Device *>(d3dDevice);
+			ComPtr<IDXGIDevice> dxgiDevice;
+			Log("ANGLE's device has feature level 0x%X", (unsigned)angleDevice->GetFeatureLevel());
+			if (SUCCEEDED(angleDevice->QueryInterface(IID_PPV_ARGS(&dxgiDevice))))
+				dxgiDevice->GetAdapter(&adapter);
+		}
+		else
+			Log("couldn't get ANGLE's device (EGL error 0x%X)", egl.GetError ? egl.GetError() : 0);
+	}
+
+	const D3D_FEATURE_LEVEL levels[] =
+	{
+		D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_11_0, D3D_FEATURE_LEVEL_10_1, D3D_FEATURE_LEVEL_10_0,
+	};
+	const UINT flags = D3D11_CREATE_DEVICE_SINGLETHREADED;
+	D3D_FEATURE_LEVEL level = D3D_FEATURE_LEVEL_10_0;
+	const D3D_DRIVER_TYPE driver = adapter ? D3D_DRIVER_TYPE_UNKNOWN : D3D_DRIVER_TYPE_HARDWARE;
+
+	HRESULT hr = D3D11CreateDevice(adapter.Get(), driver, nullptr, flags, levels, ARRAYSIZE(levels), D3D11_SDK_VERSION,
+		&g_device, &level, &g_context);
+	if (hr == E_INVALIDARG)
+	{
+		// Without 11.1, which older runtimes don't know
+		hr = D3D11CreateDevice(adapter.Get(), driver, nullptr, flags, levels + 1, ARRAYSIZE(levels) - 1, D3D11_SDK_VERSION,
+			&g_device, &level, &g_context);
+	}
+	if (Failed(hr, "D3D11CreateDevice"))
+	{
+		g_device.Reset();
+		g_context.Reset();
+		return false;
+	}
+
+	{
+		ComPtr<IDXGIDevice> dxgiDevice;
+		ComPtr<IDXGIAdapter> deviceAdapter;
+		DXGI_ADAPTER_DESC desc;
+		if (SUCCEEDED(g_device.As(&dxgiDevice)) && SUCCEEDED(dxgiDevice->GetAdapter(&deviceAdapter))
+			&& SUCCEEDED(deviceAdapter->GetDesc(&desc)))
+		{
+			char name[256];
+			WideCharToMultiByte(CP_UTF8, 0, desc.Description, -1, name, sizeof name, nullptr, nullptr);
+			Log("device: feature level 0x%X on %s (vendor 0x%04X, device 0x%04X; %llu MB video memory, %llu MB shared)",
+				(unsigned)level, name, desc.VendorId, desc.DeviceId, (unsigned long long)(desc.DedicatedVideoMemory >> 20),
+				(unsigned long long)(desc.SharedSystemMemory >> 20));
+		}
+		else
+			Log("device: feature level 0x%X", (unsigned)level);
+	}
+
+	InitVideoMemory();
+
+	if (!CreateDeviceObjects())
+	{
+		g_device.Reset();
+		g_context.Reset();
+		return false;
+	}
+
+	ProbeSharing();
+	return true;
+}
+
+bool CreateDeviceObjects()
+{
+	for (int i = 0; i < NUMVS; i++)
+	{
+		if (Failed(g_device->CreateVertexShader(kVertexShaders[i].code, kVertexShaders[i].size, nullptr, &g_vertexShaders[i]),
+			kVertexShaders[i].name))
+			return false;
+	}
+
+	for (int i = 0; i < NUMPS; i++)
+	{
+		if (Failed(g_device->CreatePixelShader(kPixelShaders[i].code, kPixelShaders[i].size, nullptr, &g_pixelShaders[i]),
+			kPixelShaders[i].name))
+		{
+			// [UWP]: A failed full wipe shader can still use r_opengl.c's two-pass wipe.
+			if (i != PS_WIPEFULL)
+				return false;
+		}
+	}
+
+	const D3D11_INPUT_ELEMENT_DESC poly[] =
+	{
+		{"POSITION", 0, DXGI_FORMAT_R32G32B32_FLOAT, 0, offsetof(FOutVector, x), D3D11_INPUT_PER_VERTEX_DATA, 0},
+		{"TEXCOORD", 0, DXGI_FORMAT_R32G32_FLOAT, 0, offsetof(FOutVector, s), D3D11_INPUT_PER_VERTEX_DATA, 0},
+	};
+	const D3D11_INPUT_ELEMENT_DESC sky[] =
+	{
+		{"POSITION", 0, DXGI_FORMAT_R32G32B32_FLOAT, 0, offsetof(gl_skyvertex_t, x), D3D11_INPUT_PER_VERTEX_DATA, 0},
+		{"TEXCOORD", 0, DXGI_FORMAT_R32G32_FLOAT, 0, offsetof(gl_skyvertex_t, u), D3D11_INPUT_PER_VERTEX_DATA, 0},
+		{"COLOR", 0, DXGI_FORMAT_R8G8B8A8_UNORM, 0, offsetof(gl_skyvertex_t, r), D3D11_INPUT_PER_VERTEX_DATA, 0},
+	};
+	const D3D11_INPUT_ELEMENT_DESC model[] =
+	{
+		{"POSITION", 0, DXGI_FORMAT_R32G32B32_FLOAT, 0, offsetof(ModelVertex, x), D3D11_INPUT_PER_VERTEX_DATA, 0},
+		{"NORMAL", 0, DXGI_FORMAT_R32G32B32_FLOAT, 0, offsetof(ModelVertex, nx), D3D11_INPUT_PER_VERTEX_DATA, 0},
+		{"TEXCOORD", 0, DXGI_FORMAT_R32G32_FLOAT, 0, offsetof(ModelVertex, s), D3D11_INPUT_PER_VERTEX_DATA, 0},
+	};
+
+	if (Failed(g_device->CreateInputLayout(poly, ARRAYSIZE(poly), g_VSPoly, sizeof g_VSPoly, &g_layouts[LAYOUT_POLY]), "CreateInputLayout (polygons)")
+		|| Failed(g_device->CreateInputLayout(sky, ARRAYSIZE(sky), g_VSSky, sizeof g_VSSky, &g_layouts[LAYOUT_SKY]), "CreateInputLayout (sky)")
+		|| Failed(g_device->CreateInputLayout(model, ARRAYSIZE(model), g_VSModel, sizeof g_VSModel, &g_layouts[LAYOUT_MODEL]), "CreateInputLayout (models)"))
+		return false;
+
+	D3D11_BUFFER_DESC constants = {};
+	constants.ByteWidth = sizeof(Constants);
+	constants.Usage = D3D11_USAGE_DYNAMIC;
+	constants.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+	constants.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+	if (Failed(g_device->CreateBuffer(&constants, nullptr, &g_constantBuffer), "CreateBuffer (constants)"))
+		return false;
+
+	if (!CreateRing(g_vertexRing, 8 << 20, D3D11_BIND_VERTEX_BUFFER, "vertex")
+		|| !CreateRing(g_indexRing, 2 << 20, D3D11_BIND_INDEX_BUFFER, "index"))
+		return false;
+
+	std::vector<UINT16> fan;
+	fan.reserve((kMaxFanVertices - 2) * 3);
+	for (UINT i = 1; i + 1 < kMaxFanVertices; i++)
+	{
+		fan.push_back(0);
+		fan.push_back((UINT16)i);
+		fan.push_back((UINT16)(i + 1));
+	}
+	if (!CreateStaticBuffer(fan.data(), (UINT)(fan.size() * sizeof(UINT16)), D3D11_BIND_INDEX_BUFFER, g_fanIndices))
+		return false;
+
+	const UINT32 black = 0xFF000000; // R, G, B 0; A 255
+	Texture blackTexture;
+	if (!CreateTextureStorage(&blackTexture, 1, 1, DXGI_FORMAT_R8G8B8A8_UNORM, false, false, &black))
+		return false;
+	g_blackTexture = blackTexture.texture;
+	g_blackSrv = blackTexture.srv;
+	g_textureBytes -= blackTexture.bytes;
+
+	D3D11_SAMPLER_DESC sampler = {};
+	sampler.Filter = D3D11_FILTER_MIN_MAG_MIP_POINT;
+	sampler.AddressU = sampler.AddressV = sampler.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+	sampler.ComparisonFunc = D3D11_COMPARISON_NEVER;
+	sampler.MaxAnisotropy = 1;
+	if (Failed(g_device->CreateSamplerState(&sampler, &g_defaultSampler), "CreateSamplerState (default)"))
+		return false;
+
+	D3D11_BLEND_DESC opaque = {};
+	opaque.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
+	D3D11_DEPTH_STENCIL_DESC noDepth = {};
+	D3D11_RASTERIZER_DESC noCull = {};
+	noCull.FillMode = D3D11_FILL_SOLID;
+	noCull.CullMode = D3D11_CULL_NONE;
+	noCull.DepthClipEnable = TRUE;
+	if (Failed(g_device->CreateBlendState(&opaque, &g_opaqueBlend), "CreateBlendState (opaque)")
+		|| Failed(g_device->CreateDepthStencilState(&noDepth, &g_noDepth), "CreateDepthStencilState (none)")
+		|| Failed(g_device->CreateRasterizerState(&noCull, &g_noCull), "CreateRasterizerState (no culling)"))
+		return false;
+
+	Log("made %d vertex shaders, %d pixel shaders, 3 input layouts, and 8 MB vertex and 2 MB index buffers", NUMVS, NUMPS);
+	return true;
+}
+
+void D3D_FlushScreenTextures(void);
+
+// r_opengl.c's SetModelView
+void SetModelView(INT32 w, INT32 h)
+{
+	// The screen textures need to be flushed if the width or height change so that they be remade for the correct size
+	if (g_screenWidth != w || g_screenHeight != h)
+	{
+		D3D_FlushScreenTextures();
+		Log("screen size %dx%d", (int)w, (int)h);
+	}
+
+	g_screenWidth = w;
+	g_screenHeight = h;
+	CreateRenderTarget(w, h);
+
+	SetViewport(0, 0, w, h);
+
+	g_matrixMode = MODE_PROJECTION;
+	MatLoadIdentity();
+
+	g_matrixMode = MODE_MODELVIEW;
+	MatLoadIdentity();
+
+	Perspective(g_fov, 1.0f);
+}
+
+// r_opengl.c's SetStates
+void SetStates()
+{
+	g_gl.texture2D = true;
+	g_gl.texEnv = TE_MODULATE;
+
+	g_gl.alphaTest = true;
+	g_gl.alphaFunc = AF_NOTEQUAL;
+	g_gl.alphaRef = 0.0f;
+
+	g_gl.blend = true;
+
+	g_gl.depthTest = true;
+	g_gl.depthMask = true;
+	g_gl.depthAlways = false;
+
+	// this set CurrentPolyFlags to the actual configuration
+	g_currentPolyFlags = 0xffffffff;
+	D3D_SetBlend(0);
+
+	g_texDownloaded = 0;
+	SetNoTexture(0);
+
+	g_gl.lighting = false;
+
+	// bp : when no t&l :)
+	MatLoadIdentity();
+	MatScale(1.0f, 1.0f, -1.0f);
+}
+
+void D3D_SetPalette(RGBA_t *palette)
+{
+	// on a palette change, you have to reload all of the textures
+	if (memcmp(g_palette, palette, sizeof g_palette))
+	{
+		CpuTimer timer(g_stats.textureTime);
+		memcpy(g_palette, palette, sizeof g_palette);
+		Flush();
+	}
+}
