+// [UWP]: Report what Direct3D 12 (which Mesa's OpenGL driver runs on) offers on this console
+static void UWPLogD3D12(void)
+{
+	static boolean logged = false;
+	ID3D12Device *device = nullptr;
+	HRESULT hr;
+
+	if (logged)
+		return;
+	logged = true;
+
+	hr = D3D12CreateDevice(nullptr, D3D_FEATURE_LEVEL_11_0, IID_PPV_ARGS(&device));
+	if (FAILED(hr))
+	{
+		I_OutputMsg("UWP: D3D12CreateDevice failed (0x%08lx)\n", (unsigned long)hr);
+		return;
+	}
+
+	{
+		static const D3D_FEATURE_LEVEL levels[] = {D3D_FEATURE_LEVEL_11_0, D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_12_0, D3D_FEATURE_LEVEL_12_1};
+		D3D12_FEATURE_DATA_FEATURE_LEVELS featurelevels = {};
+		featurelevels.NumFeatureLevels = sizeof levels / sizeof *levels;
+		featurelevels.pFeatureLevelsRequested = levels;
+		hr = device->CheckFeatureSupport(D3D12_FEATURE_FEATURE_LEVELS, &featurelevels, sizeof featurelevels);
+		if (SUCCEEDED(hr))
+			I_OutputMsg("UWP: D3D12 max feature level 0x%x\n", (unsigned)featurelevels.MaxSupportedFeatureLevel);
+		else
+			I_OutputMsg("UWP: D3D12 feature level check failed (0x%08lx)\n", (unsigned long)hr);
+	}
+
+	{
+		// Newer shader models are rejected by runtimes that don't know them, so try from newest to oldest
+		static const D3D_SHADER_MODEL models[] = {D3D_SHADER_MODEL_6_5, D3D_SHADER_MODEL_6_4, D3D_SHADER_MODEL_6_3, D3D_SHADER_MODEL_6_2, D3D_SHADER_MODEL_6_1, D3D_SHADER_MODEL_6_0, D3D_SHADER_MODEL_5_1};
+		size_t i;
+
+		for (i = 0; i < sizeof models / sizeof *models; i++)
+		{
+			D3D12_FEATURE_DATA_SHADER_MODEL shadermodel = {models[i]};
+			hr = device->CheckFeatureSupport(D3D12_FEATURE_SHADER_MODEL, &shadermodel, sizeof shadermodel);
+			if (SUCCEEDED(hr))
+			{
+				I_OutputMsg("UWP: D3D12 highest shader model 0x%x\n", (unsigned)shadermodel.HighestShaderModel);
+				break;
+			}
+		}
+		if (i == sizeof models / sizeof *models)
+			I_OutputMsg("UWP: D3D12 shader model check failed (0x%08lx)\n", (unsigned long)hr);
+	}
+
+	device->Release();
+}
