#include <cassert>
#include <cstdio>
#include <cstdint>
#include <memory>
#include <unordered_map>
#include <vector>
using UINT8=uint8_t;
using UINT32=uint32_t;
@@ENUMS@@
enum D3D11_BLEND { D3D11_BLEND_ZERO, D3D11_BLEND_ONE, D3D11_BLEND_SRC_ALPHA,
    D3D11_BLEND_INV_SRC_ALPHA, D3D11_BLEND_SRC_COLOR, D3D11_BLEND_DEST_COLOR,
    D3D11_BLEND_INV_DEST_COLOR };
enum { D3D11_BLEND_OP_ADD, D3D11_BLEND_OP_SUBTRACT, D3D11_BLEND_OP_REV_SUBTRACT };
struct D3D11_RENDER_TARGET_BLEND_DESC {
    bool BlendEnable;
    D3D11_BLEND SrcBlend,DestBlend,SrcBlendAlpha,DestBlendAlpha;
    int BlendOp,BlendOpAlpha; UINT8 RenderTargetWriteMask;
};
struct D3D11_BLEND_DESC { D3D11_RENDER_TARGET_BLEND_DESC RenderTarget[1]; };
struct ID3D11BlendState { D3D11_BLEND_DESC desc; };
template<class T> struct ComPtr { T *p=nullptr; T* Get(){return p;} T** operator&(){return &p;} };
struct Device {
    std::vector<std::unique_ptr<ID3D11BlendState>> states;
    int CreateBlendState(const D3D11_BLEND_DESC *desc,ID3D11BlendState **out) {
        states.emplace_back(new ID3D11BlendState{*desc}); *out=states.back().get(); return 0;
    }
} device;
Device *g_device=&device;
static bool Failed(int result,const char *) { return result!=0; }
std::unordered_map<UINT32,ComPtr<ID3D11BlendState>> g_blendStates;
struct { bool blend; UINT8 blendSrc,blendDst,blendEquation,colorWriteMask; } g_gl;
bool g_fogRemap;
@@TO_BLEND@@
@@BLEND_STATE@@
int main() {
    g_gl.blend=true; g_gl.blendSrc=BF_SRC_ALPHA; g_gl.blendDst=BF_SRC_COLOR;
    g_gl.blendEquation=BE_ADD;
    for(UINT8 mask : {0,7}) {
        g_gl.colorWriteMask=mask;
        g_fogRemap=false;
        auto ordinary=GetBlendState()->desc.RenderTarget[0];
        assert(ordinary.BlendEnable && ordinary.DestBlend==D3D11_BLEND_SRC_COLOR);
        g_fogRemap=true;
        auto remap=GetBlendState()->desc.RenderTarget[0];
        assert(!remap.BlendEnable && remap.RenderTargetWriteMask==mask);
        // Leaving the remap must restore the ordinary transparent blend state,
        // including after the cached override was used repeatedly.
        assert(!GetBlendState()->desc.RenderTarget[0].BlendEnable);
        g_fogRemap=false;
        assert(GetBlendState()->desc.RenderTarget[0].BlendEnable);
        assert(GetBlendState()->desc.RenderTarget[0].RenderTargetWriteMask==mask);
    }
    puts("Complete composites bypass a second framebuffer blend and preserve write masks/state restoration");
}
