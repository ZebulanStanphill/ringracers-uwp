static const char*ReadLightTable(LightTable&t,std::vector<RGBA_t>&gpu){++tableReads;gpu.resize(256*33);assert(t.res->bytes.size()==gpu.size()*sizeof(RGBA_t));std::memcpy(gpu.data(),t.res->bytes.data(),t.res->bytes.size());return nullptr;}
static void DumpTextureEvents(UINT32){++eventDumps;}
void CheckLightTable(UINT32,LightTable&,const char*,bool,const char* = nullptr);
