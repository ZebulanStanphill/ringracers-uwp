struct ID3D12Resource {std::vector<UINT8> bytes; UINT width=256,height=33; UINT8 value=0; ID3D12Resource(){++live;} ~ID3D12Resource(){--live;} int Map(UINT,const D3D12_RANGE *r,void **out){++maps;assert(completed&&r->Begin==0&&r->End==2560);if(failure==4)return 1;*out=bytes.data();return 0;} void Unmap(UINT,const D3D12_RANGE*r){++unmaps;assert(!r->Begin&&!r->End);} };
template<class T> struct ComPtr {std::shared_ptr<T> p; T*Get()const{return p.get();} T*operator->()const{return Get();} explicit operator bool()const{return bool(p);} };
