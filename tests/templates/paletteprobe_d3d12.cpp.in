 Reset();texture.res->value=17;queued.push_back([]{texture.res->value=255;events.push_back("upload");});assert(!ReadPaletteProbe(texture,samples));assert(samples[4].rgba==0xffffffff&&events==std::vector<std::string>({"retire","submit","upload"})&&completed&&maps==1);
