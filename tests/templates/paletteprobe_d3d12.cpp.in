static void Transition(GpuTexture&t,int s){transitions.push_back(s);t.state=s;}
static void Core_FlushBarriers(){++flushes;}
struct List {void CopyTextureRegion(const D3D12_TEXTURE_COPY_LOCATION*to,UINT x,UINT y,UINT z,const D3D12_TEXTURE_COPY_LOCATION*from,const D3D12_BOX*b){assert(!x&&!y&&!z);assert(to->Type==D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT&&from->Type==D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX);auto f=to->PlacedFootprint.Footprint;assert(f.Width==1&&f.Height==1&&f.Depth==1&&f.RowPitch==256);assert(b->right==b->left+1&&b->bottom==b->top+1&&b->back==b->front+1);copies.push_back({*b,to->PlacedFootprint.Offset,from->pResource});auto source=from->pResource;auto dest=to->pResource;auto offset=to->PlacedFootprint.Offset;auto box=*b;queued.push_back([source,dest,offset,f,box]{if(source->bytes.empty()) std::memset(dest->bytes.data()+offset,UINT8(source->value+(box.top==32)),f.Format);else std::memcpy(dest->bytes.data()+offset,source->bytes.data()+((box.front*source->height+box.top)*source->width+box.left)*f.Format,f.Format);});}};
static List*Core_List(){static List list;return &list;}
struct Device {int CreateCommittedResource(const D3D12_HEAP_PROPERTIES*h,int,const D3D12_RESOURCE_DESC*d,int s,void*,ComPtr<ID3D12Resource>*out){++allocations;assert(h->Type==D3D12_HEAP_TYPE_READBACK&&s==D3D12_RESOURCE_STATE_COPY_DEST&&d->Width==2560&&d->Height==1&&d->SampleDesc.Count==1);if(failure==1)return 1;out->p=std::make_shared<ID3D12Resource>();out->p->bytes.assign(d->Width,0xee);return 0;}};
static Device*Core_Device(){static Device d;return &d;} static bool Core_Failed(int hr,const char*){return hr!=0;}
static std::vector<ComPtr<ID3D12Resource>> retired;
static void Core_Retire(ComPtr<ID3D12Resource>&r){retireFence=pending;retired.push_back(r);r.p.reset();events.push_back("retire");}
static UINT64 Core_Submit(const char*s){assert(std::string(s)=="probe");++submits;events.push_back("submit");assert(g_paletteLookup.state==3&&g_screenPalette.state==4&&g_currentLightTable->state==5&&g_units[0]->state==6);cacheValid=false;UINT64 f=pending++;if(failure!=2){for(auto &work:queued)work();queued.clear();}return failure==2?0:f;}
static bool Core_Wait(UINT64 f,UINT timeout,const char*s){++waits;assert(f==retireFence&&timeout==500&&std::string(s)=="paletteprobe");completed=failure!=3;return completed;}
static std::vector<std::string> logs;template<class...T>void Log(const char*s,T...args){char out[2048];std::snprintf(out,sizeof out,s,args...);logs.push_back(out);}
